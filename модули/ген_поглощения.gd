extends RefCounted

const КодыМодулей = preload("res://геном/коды_модулей.gd")


static func прочитать(части: PackedStringArray) -> Dictionary:
	if части.size() != 2:
		return {
			"ошибка": "Ген поглощения должен иметь формат: 01,материя;"
		}

	var текст_материи: String = части[1].strip_edges()

	if not текст_материи.is_valid_float():
		return {
			"ошибка": "Некорректное количество материи поглотителя: '%s'" % текст_материи
		}

	var материя: float = текст_материи.to_float()

	if материя <= 0.0:
		return {
			"ошибка": "Материя поглотителя должна быть больше нуля."
		}

	return {
		"тип": КодыМодулей.ПОГЛОЩЕНИЕ,
		"материя": материя
	}
