extends RefCounted

const КодыМодулей = preload("res://геном/коды_модулей.gd")


static func прочитать(части: PackedStringArray) -> Dictionary:
	if части.size() != 3:
		return {
			"ошибка": "Ген накопления должен иметь формат: 02,материя,коэффициент_утечки;"
		}

	var текст_материи: String = части[1].strip_edges()
	var текст_утечки: String = части[2].strip_edges()

	if not текст_материи.is_valid_float():
		return {
			"ошибка": "Некорректное количество материи накопителя: '%s'" % текст_материи
		}

	if not текст_утечки.is_valid_float():
		return {
			"ошибка": "Некорректный коэффициент утечки накопителя: '%s'" % текст_утечки
		}

	var материя: float = текст_материи.to_float()
	var коэффициент_утечки: float = текст_утечки.to_float()

	if материя <= 0.0:
		return {
			"ошибка": "Материя накопителя должна быть больше нуля."
		}

	if коэффициент_утечки <= 0.0:
		return {
			"ошибка": "Коэффициент утечки должен быть больше нуля."
		}

	return {
		"тип": КодыМодулей.НАКОПЛЕНИЕ,
		"материя": материя,
		"коэффициент_утечки": коэффициент_утечки
	}
