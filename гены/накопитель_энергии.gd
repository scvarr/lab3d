extends RefCounted

const КодыГенов = preload("res://геном/коды_генов.gd")


static func прочитать(части: PackedStringArray) -> Dictionary:
	if части.size() != 3:
		return {
			"ошибка": "Ген накопителя должен иметь формат: 02,органика,коэффициент_утечки;"
		}

	var текст_органики: String = части[1].strip_edges()
	var текст_утечки: String = части[2].strip_edges()

	if not текст_органики.is_valid_float():
		return {
			"ошибка": "Некорректное количество органики накопителя: '%s'" % текст_органики
		}

	if not текст_утечки.is_valid_float():
		return {
			"ошибка": "Некорректный коэффициент утечки накопителя: '%s'" % текст_утечки
		}

	var органика: float = текст_органики.to_float()
	var коэффициент_утечки: float = текст_утечки.to_float()

	if органика <= 0.0:
		return {
			"ошибка": "Органика накопителя должна быть больше нуля."
		}

	if коэффициент_утечки <= 0.0:
		return {
			"ошибка": "Коэффициент утечки должен быть больше нуля."
		}

	return {
		"тип": КодыГенов.НАКОПИТЕЛЬ_ЭНЕРГИИ,
		"органика": органика,
		"коэффициент_утечки": коэффициент_утечки
	}
