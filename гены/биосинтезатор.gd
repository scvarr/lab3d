extends RefCounted

const КодыГенов = preload("res://геном/коды_генов.gd")


static func прочитать(части: PackedStringArray) -> Dictionary:
	if части.size() != 2:
		return {
			"ошибка": "Ген биосинтезатора должен иметь формат: 03,органика;"
		}

	var текст_органики: String = части[1].strip_edges()

	if not текст_органики.is_valid_float():
		return {
			"ошибка": "Некорректное количество органики биосинтезатора: '%s'" % текст_органики
		}

	var органика: float = текст_органики.to_float()

	if органика <= 0.0:
		return {
			"ошибка": "Органика биосинтезатора должна быть больше нуля."
		}

	return {
		"тип": КодыГенов.БИОСИНТЕЗАТОР,
		"органика": органика
	}
