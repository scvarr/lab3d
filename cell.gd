extends MeshInstance3D

@export var геном: String = "01,1.0;02,5.0,0.01;"
@export var солнечный_поток: float = 0.1
@export var критическая_температура: float = 1.0

const КодыМодулей = preload("res://геном/коды_модулей.gd")
const РазборГенома = preload("res://геном/разбор_генома.gd")

const ПОРОГ_ПОВЕРХНОСТИ: float = 0.5
const КОЛЬЦА_ФОРМЫ: int = 24
const СЕГМЕНТЫ_ФОРМЫ: int = 48
const ШАГИ_ПОИСКА_ПОВЕРХНОСТИ: int = 18
const ВИЗУАЛЬНЫЙ_МАСШТАБ: float = 0.5

var температура: float = 0.0
var жива: bool = true
var время_до_вывода: float = 0.0
var время_жизни: float = 0.0

var модули: Array[Dictionary] = []

var есть_модуль_поглощения: bool = false
var материя_поглотителя: float = 0.0

var есть_модуль_накопления: bool = false
var материя_накопителя: float = 0.0
var емкость_накопителя: float = 0.0
var энергия_накопителя: float = 0.0
var коэффициент_утечки: float = 0.0

var центры_модулей: Array[Vector3] = []
var радиусы_модулей: Array[float] = []


func _ready() -> void:
	var результат: Dictionary = РазборГенома.прочитать(геном)

	if результат.has("ошибка"):
		push_error(результат["ошибка"])
		set_process(false)
		return

	модули = результат["модули"]

	if not применить_модули():
		set_process(false)
		return

	if критическая_температура <= 0.0:
		push_error("Критическая температура должна быть больше нуля.")
		set_process(false)
		return

	подготовить_поле_формы()

	if not построить_форму():
		set_process(false)
		return

	print("Геном прочитан: %s" % геном)
	print("Построена единая форма из %d модулей." % модули.size())
	вывести_состояние()
	время_до_вывода = 1.0


func _process(delta: float) -> void:
	if not жива:
		return

	время_жизни += delta

	if есть_модуль_поглощения:
		поглотить_свет(delta)

	обработать_утечку(delta)

	if температура >= критическая_температура:
		погибнуть()
		return

	время_до_вывода -= delta
	if время_до_вывода <= 0.0:
		вывести_состояние()
		время_до_вывода = 1.0


func применить_модули() -> bool:
	for модуль: Dictionary in модули:
		var тип: int = модуль["тип"]

		match тип:
			КодыМодулей.ПОГЛОЩЕНИЕ:
				if есть_модуль_поглощения:
					push_error("Пока поддерживается только один модуль поглощения.")
					return false

				есть_модуль_поглощения = true
				материя_поглотителя = модуль["материя"]

			КодыМодулей.НАКОПЛЕНИЕ:
				if есть_модуль_накопления:
					push_error("Пока поддерживается только один модуль накопления.")
					return false

				есть_модуль_накопления = true
				материя_накопителя = модуль["материя"]
				емкость_накопителя = материя_накопителя
				коэффициент_утечки = модуль["коэффициент_утечки"]

	if not есть_модуль_поглощения:
		push_error("Клетка не содержит модуля поглощения.")
		return false

	return true


func поглотить_свет(delta: float) -> void:
	var площадь_поглощения: float = pow(материя_поглотителя, 2.0 / 3.0)
	var поглощенная_энергия: float = солнечный_поток * площадь_поглощения * delta

	if not есть_модуль_накопления:
		добавить_тепло(поглощенная_энергия)
		return

	var свободная_емкость: float = max(0.0, емкость_накопителя - энергия_накопителя)
	var сохраненная_энергия: float = min(поглощенная_энергия, свободная_емкость)
	var лишняя_энергия: float = поглощенная_энергия - сохраненная_энергия

	энергия_накопителя += сохраненная_энергия
	добавить_тепло(лишняя_энергия)


func обработать_утечку(delta: float) -> void:
	if not есть_модуль_накопления or энергия_накопителя <= 0.0:
		return

	var заполненность: float = энергия_накопителя / емкость_накопителя
	var площадь_утечки: float = pow(материя_накопителя, 2.0 / 3.0)
	var утечка_в_секунду: float = коэффициент_утечки * площадь_утечки * заполненность
	var потерянная_энергия: float = min(энергия_накопителя, утечка_в_секунду * delta)

	энергия_накопителя -= потерянная_энергия
	добавить_тепло(потерянная_энергия)


func добавить_тепло(энергия: float) -> void:
	if энергия <= 0.0:
		return

	температура += энергия / получить_общую_материю()


func получить_общую_материю() -> float:
	return материя_поглотителя + материя_накопителя


func подготовить_поле_формы() -> void:
	центры_модулей.clear()
	радиусы_модулей.clear()

	var текущий_x: float = 0.0
	var предыдущий_радиус: float = 0.0

	for номер: int in range(модули.size()):
		var материя: float = модули[номер]["материя"]
		var радиус: float = pow(материя, 1.0 / 3.0)

		if номер > 0:
			текущий_x += (предыдущий_радиус + радиус) * 0.75

		центры_модулей.append(Vector3(текущий_x, 0.0, 0.0))
		радиусы_модулей.append(радиус)
		предыдущий_радиус = радиус

	if центры_модулей.is_empty():
		return

	var первый_x: float = центры_модулей[0].x
	var последний_x: float = центры_модулей[центры_модулей.size() - 1].x
	var центр_формы: float = (первый_x + последний_x) * 0.5

	for номер: int in range(центры_модулей.size()):
		центры_модулей[номер].x -= центр_формы


func получить_влияние_модуля(номер: int, точка: Vector3) -> float:
	var радиус: float = радиусы_модулей[номер]
	var квадрат_радиуса: float = радиус * радиус
	var квадрат_расстояния: float = точка.distance_squared_to(центры_модулей[номер])
	return квадрат_радиуса / (квадрат_расстояния + квадрат_радиуса)


func получить_поле_формы(точка: Vector3) -> float:
	var поле: float = 0.0

	for номер: int in range(центры_модулей.size()):
		поле += получить_влияние_модуля(номер, точка)

	return поле


func найти_радиус_поверхности(направление: Vector3) -> float:
	var нижняя_граница: float = 0.0
	var верхняя_граница: float = 1.0

	for номер: int in range(центры_модулей.size()):
		var возможная_граница: float = центры_модулей[номер].length() + радиусы_модулей[номер] * 2.0
		верхняя_граница = max(верхняя_граница, возможная_граница)

	var попытка: int = 0
	while получить_поле_формы(направление * верхняя_граница) > ПОРОГ_ПОВЕРХНОСТИ and попытка < 8:
		верхняя_граница *= 2.0
		попытка += 1

	for шаг: int in range(ШАГИ_ПОИСКА_ПОВЕРХНОСТИ):
		var середина: float = (нижняя_граница + верхняя_граница) * 0.5
		var поле: float = получить_поле_формы(направление * середина)

		if поле >= ПОРОГ_ПОВЕРХНОСТИ:
			нижняя_граница = середина
		else:
			верхняя_граница = середина

	return (нижняя_граница + верхняя_граница) * 0.5


func получить_цвет_модуля(тип: int) -> Color:
	match тип:
		КодыМодулей.ПОГЛОЩЕНИЕ:
			return Color(0.15, 0.85, 0.25)

		КодыМодулей.НАКОПЛЕНИЕ:
			return Color(0.15, 0.4, 1.0)

		_:
			return Color(0.7, 0.7, 0.7)


func получить_цвет_формы(точка: Vector3) -> Color:
	var красный: float = 0.0
	var зеленый: float = 0.0
	var синий: float = 0.0
	var сумма: float = 0.0

	for номер: int in range(модули.size()):
		var влияние: float = получить_влияние_модуля(номер, точка)
		var цвет: Color = получить_цвет_модуля(модули[номер]["тип"])

		красный += цвет.r * влияние
		зеленый += цвет.g * влияние
		синий += цвет.b * влияние
		сумма += влияние

	if сумма <= 0.0:
		return Color.WHITE

	return Color(красный / сумма, зеленый / сумма, синий / сумма)


func добавить_вершину_формы(инструмент: SurfaceTool, направление: Vector3) -> void:
	var радиус: float = найти_радиус_поверхности(направление)
	var точка: Vector3 = направление * радиус

	инструмент.set_color(получить_цвет_формы(точка))
	инструмент.add_vertex(точка)


func построить_форму() -> bool:
	if центры_модулей.is_empty():
		push_error("Невозможно построить форму без модулей.")
		return false

	if получить_поле_формы(Vector3.ZERO) < ПОРОГ_ПОВЕРХНОСТИ:
		push_error("Центр клетки оказался вне общего поля модулей.")
		return false

	var инструмент := SurfaceTool.new()
	инструмент.begin(Mesh.PRIMITIVE_TRIANGLES)

	добавить_вершину_формы(инструмент, Vector3.UP)

	for кольцо: int in range(1, КОЛЬЦА_ФОРМЫ):
		var угол_широты: float = PI * float(кольцо) / float(КОЛЬЦА_ФОРМЫ)
		var высота: float = cos(угол_широты)
		var радиус_кольца: float = sin(угол_широты)

		for сегмент: int in range(СЕГМЕНТЫ_ФОРМЫ):
			var угол_долготы: float = TAU * float(сегмент) / float(СЕГМЕНТЫ_ФОРМЫ)
			var направление := Vector3(
				радиус_кольца * cos(угол_долготы),
				высота,
				радиус_кольца * sin(угол_долготы)
			)

			добавить_вершину_формы(инструмент, направление)

	var индекс_южного_полюса: int = 1 + (КОЛЬЦА_ФОРМЫ - 1) * СЕГМЕНТЫ_ФОРМЫ
	добавить_вершину_формы(инструмент, Vector3.DOWN)

	var начало_первого_кольца: int = 1

	for сегмент: int in range(СЕГМЕНТЫ_ФОРМЫ):
		var следующий: int = (сегмент + 1) % СЕГМЕНТЫ_ФОРМЫ

		инструмент.add_index(0)
		инструмент.add_index(начало_первого_кольца + следующий)
		инструмент.add_index(начало_первого_кольца + сегмент)

	for кольцо: int in range(КОЛЬЦА_ФОРМЫ - 2):
		var верхнее_кольцо: int = 1 + кольцо * СЕГМЕНТЫ_ФОРМЫ
		var нижнее_кольцо: int = верхнее_кольцо + СЕГМЕНТЫ_ФОРМЫ

		for сегмент: int in range(СЕГМЕНТЫ_ФОРМЫ):
			var следующий: int = (сегмент + 1) % СЕГМЕНТЫ_ФОРМЫ

			var верхний_текущий: int = верхнее_кольцо + сегмент
			var верхний_следующий: int = верхнее_кольцо + следующий
			var нижний_текущий: int = нижнее_кольцо + сегмент
			var нижний_следующий: int = нижнее_кольцо + следующий

			инструмент.add_index(верхний_текущий)
			инструмент.add_index(верхний_следующий)
			инструмент.add_index(нижний_текущий)

			инструмент.add_index(верхний_следующий)
			инструмент.add_index(нижний_следующий)
			инструмент.add_index(нижний_текущий)

	var начало_последнего_кольца: int = 1 + (КОЛЬЦА_ФОРМЫ - 2) * СЕГМЕНТЫ_ФОРМЫ

	for сегмент: int in range(СЕГМЕНТЫ_ФОРМЫ):
		var следующий: int = (сегмент + 1) % СЕГМЕНТЫ_ФОРМЫ

		инструмент.add_index(начало_последнего_кольца + сегмент)
		инструмент.add_index(начало_последнего_кольца + следующий)
		инструмент.add_index(индекс_южного_полюса)

	инструмент.generate_normals()
	mesh = инструмент.commit()
	scale = Vector3.ONE * ВИЗУАЛЬНЫЙ_МАСШТАБ
	material_override = создать_материал_клетки()

	return true


func погибнуть() -> void:
	жива = false
	material_override = создать_материал(Color(0.03, 0.03, 0.03))
	print("Клетка погибла от перегрева. Время жизни: %.2f с | Температура: %.4f" % [время_жизни, температура])


func вывести_состояние() -> void:
	print("Энергия: %.4f / %.4f | Температура: %.4f / %.4f | Материя: %.4f" % [
		энергия_накопителя,
		емкость_накопителя,
		температура,
		критическая_температура,
		получить_общую_материю()
	])


func создать_материал_клетки() -> StandardMaterial3D:
	var материал := StandardMaterial3D.new()
	материал.vertex_color_use_as_albedo = true
	материал.roughness = 0.7
	return материал


func создать_материал(цвет: Color) -> StandardMaterial3D:
	var материал := StandardMaterial3D.new()
	материал.albedo_color = цвет
	return материал
