class_name Клетка
extends Node3D

@export var геном_hex: String = "0103E8047E0320044C02138803B604B003840064030FA0051403840352041388041A041A041A0507D0044C038404B0060BB8047E03B6047E0703E803E803E801900703E803E803E801900703E803E803E80190"
@export var солнечный_поток: float = 0.1
@export var критическая_температура: float = 1.0
@export var показывать_внутренние_модули: bool = false
@export var показывать_точки_сцепки: bool = true

const ЭнергетикаКлетки = preload("res://клетка/энергетика_клетки.gd")
const АнализаторКлетки = preload("res://клетка/анализатор_клетки.gd")
const СборщикКлетки = preload("res://клетка/сборщик_клетки.gd")

@onready var представление: ПредставлениеКлетки = $Представление

var жива: bool = true
var время_до_вывода: float = 0.0
var время_жизни: float = 0.0

var сборка: СборкаКлетки
var конструкция: КонструкцияКлетки
var энергетика := ЭнергетикаКлетки.new()


func назначить_сборку(новая_сборка: СборкаКлетки) -> bool:
	if новая_сборка == null:
		return false

	if is_node_ready():
		return false

	сборка = новая_сборка
	геном_hex = сборка.геном_hex

	return true


func _ready() -> void:
	if сборка == null:
		var результат_сборки: Dictionary = СборщикКлетки.собрать_из_hex(
			геном_hex
		)

		if результат_сборки.has("ошибка"):
			остановить_инициализацию(результат_сборки["ошибка"])
			return

		сборка = результат_сборки["сборка"]
		геном_hex = сборка.геном_hex

	конструкция = сборка.конструкция

	if конструкция == null:
		остановить_инициализацию("Сборка клетки не содержит конструкции.")
		return

	if критическая_температура <= 0.0:
		остановить_инициализацию(
			"Критическая температура должна быть больше нуля."
		)
		return

	энергетика.настроить(конструкция)

	if сборка.морфология == null:
		остановить_инициализацию("Сборка клетки не содержит морфологии.")
		return

	if not представление.построить(
		сборка.морфология,
		показывать_внутренние_модули,
		показывать_точки_сцепки
	):
		остановить_инициализацию("Не удалось построить представление клетки.")
		return

	var характеристики: Dictionary = АнализаторКлетки.рассчитать(
		конструкция,
		солнечный_поток
	)

	вывести_характеристики(характеристики)

	print("HEX-геном прочитан: %s" % сборка.геном_hex)
	print(
		"Построена единая форма из %d модулей."
		% конструкция.получить_количество_функций()
	)

	вывести_состояние()
	время_до_вывода = 1.0


func остановить_инициализацию(сообщение: String) -> void:
	push_error(сообщение)
	set_process(false)


func _process(delta: float) -> void:
	if not жива:
		return

	время_жизни += delta
	энергетика.обновить(delta, солнечный_поток)

	if энергетика.состояние.температура >= критическая_температура:
		погибнуть()
		return

	время_до_вывода -= delta

	if время_до_вывода <= 0.0:
		вывести_состояние()
		время_до_вывода = 1.0


func погибнуть() -> void:
	жива = false
	представление.показать_гибель()

	print("Клетка погибла от перегрева. Время жизни: %.2f с | Температура: %.4f" % [
		время_жизни,
		энергетика.состояние.температура
	])


func вывести_состояние() -> void:
	var состояние: СостояниеКлетки = энергетика.состояние
	var профиль: ПрофильФункций = конструкция.профиль

	print("Энергия: %.4f / %.4f 
	| Свободная органика: %.4f / %.4f 
	| Термат: %.4f / %.4f 
	| Тепло термата: %.4f / %.4f
	| Температура: %.4f / %.4f 
	| Органика клетки: %.4f" % [
		состояние.энергия,
		профиль.емкость_энергии,
		состояние.свободная_органика,
		профиль.емкость_органики,
		состояние.термат,
		профиль.емкость_термата,
		состояние.поглощенное_тепло_термата,
		состояние.термат,
		состояние.температура,
		критическая_температура,
		конструкция.структурная_органика
	])


func вывести_характеристики(характеристики: Dictionary) -> void:
	print("""
Характеристики клетки:
  функций: %d
  поглотителей энергии: %d
  накопителей энергии: %d
  структурная органика: %.4f
  теплоёмкость: %.4f
  площадь поглощения: %.4f
  ёмкость энергии: %.4f
  получение энергии при потоке %.4f: %.4f энергии/с
  утечка энергии при полном заполнении: %.6f энергии/с
  биосинтезаторов: %d
  обработка биосинтеза: %.6f энергии/с
  общий КПД биосинтеза: %.4f
  создание органики: %.6f органики/с
  тепловые потери биосинтеза: %.6f энергии/с
""" % [
		характеристики["количество_функций"],
		характеристики["количество_поглотителей"],
		характеристики["количество_накопителей_энергии"],
		характеристики["структурная_органика"],
		характеристики["теплоемкость"],
		характеристики["суммарная_площадь_поглощения"],
		характеристики["емкость_энергии"],
		солнечный_поток,
		характеристики["поглощение_при_текущем_потоке"],
		характеристики["утечка_энергии_при_полном_заполнении"],
		характеристики["количество_биосинтезаторов"],
		характеристики["скорость_обработки_биосинтеза"],
		характеристики["общий_кпд_биосинтеза"],
		характеристики["скорость_создания_органики"],
		характеристики["тепловые_потери_биосинтеза"]
	])
