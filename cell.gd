extends MeshInstance3D

@export var геном_hex: String = "0103E8047E0320044C02138803B604B003840064030FA0051403840352041388041A041A041A0507D0044C038404B0060BB8047E03B6047E0703E803E803E801900703E803E803E801900703E803E803E80190"
@export var солнечный_поток: float = 0.1
@export var критическая_температура: float = 1.0
@export var показывать_внутренние_модули: bool = false

const ФормаКлетки = preload("res://клетка/форма_клетки.gd")
const ЭнергетикаКлетки = preload("res://клетка/энергетика_клетки.gd")
const HexКодек = preload("res://геном/hex_кодек.gd")
const ГенетическийИнтерпретатор = preload("res://геном/генетический_интерпретатор.gd")

const ОГРАНИКА_ТЕЛА_НА_МОДУЛЬ: float = 1.0

var жива: bool = true
var время_до_вывода: float = 0.0
var время_жизни: float = 0.0

var модули: Array[Dictionary] = []
var полный_геном: PackedByteArray = PackedByteArray()

var генератор_формы := ФормаКлетки.new()
var энергетика := ЭнергетикаКлетки.new()


func _ready() -> void:
	var результат_hex: Dictionary = HexКодек.hex_в_байты(геном_hex)

	if результат_hex.has("ошибка"):
		push_error(результат_hex["ошибка"])
		set_process(false)
		return

	полный_геном = результат_hex["байты"]	

	var доступные_участки: Array[Dictionary] = [{
		"начало_бита": 0,
		"длина_бит": полный_геном.size() * 8
	}]

	var результат_экспрессии: Dictionary = ГенетическийИнтерпретатор.выразить(полный_геном, доступные_участки)

	if результат_экспрессии.has("ошибка"):
		push_error(результат_экспрессии["ошибка"])
		set_process(false)
		return
	
	модули = результат_экспрессии["выраженные_функции"]

	if модули.is_empty():
		push_error("HEX-геном не выразил ни одной функции клетки.")
		set_process(false)
		return

	if not энергетика.настроить(модули, ОГРАНИКА_ТЕЛА_НА_МОДУЛЬ):
		set_process(false)
		return

	if критическая_температура <= 0.0:
		push_error("Критическая температура должна быть больше нуля.")
		set_process(false)
		return

	var новая_форма: ArrayMesh = генератор_формы.построить(модули, ОГРАНИКА_ТЕЛА_НА_МОДУЛЬ)

	if новая_форма == null:
		set_process(false)
		return

	mesh = новая_форма
	scale = Vector3.ONE * генератор_формы.получить_визуальный_масштаб()

	if показывать_внутренние_модули:
		material_override = генератор_формы.создать_материал_прозрачной_клетки()
		add_child(генератор_формы.создать_визуализацию_модулей())
	else:
		material_override = генератор_формы.создать_материал_клетки()

	print("HEX-геном прочитан: %s" % HexКодек.байты_в_hex(полный_геном))
	print("Построена единая форма из %d модулей." % модули.size())

	вывести_состояние()
	время_до_вывода = 1.0


func _process(delta: float) -> void:
	if not жива:
		return

	время_жизни += delta
	энергетика.обновить(delta, солнечный_поток)

	if энергетика.температура >= критическая_температура:
		погибнуть()
		return

	время_до_вывода -= delta

	if время_до_вывода <= 0.0:
		вывести_состояние()
		время_до_вывода = 1.0


func погибнуть() -> void:
	жива = false
	material_override = генератор_формы.создать_материал_гибели()

	print("Клетка погибла от перегрева. Время жизни: %.2f с | Температура: %.4f" % [
		время_жизни,
		энергетика.температура
	])


func вывести_состояние() -> void:
	print("Энергия: %.4f / %.4f 
	| Свободная органика: %.4f / %.4f 
	| Термат: %.4f / %.4f 
	| Тепло термата: %.4f / %.4f
	| Температура: %.4f / %.4f 
	| Органика клетки: %.4f" % 
		[
		энергетика.накопленная_энергия,
		энергетика.емкость_накопителя_энергии,
		энергетика.свободная_органика,
		энергетика.емкость_органики,
		энергетика.накопленный_термат,
		энергетика.емкость_накопителя_термата,
		энергетика.поглощенное_тепло_термата,
		энергетика.накопленный_термат,
		энергетика.температура,
		критическая_температура,
		энергетика.получить_общую_органику()
	])
