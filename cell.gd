extends MeshInstance3D

@export var источник_энергии: Node3D
@export var скорость_поглощения: float = 1.0
@export_range(0.0, 1.0) var кпд_поглощения: float = 0.8
@export var базовая_скорость_роста: float = 0.05
@export var базовая_стоимость_материи: float = 1.0
@export var рост_стоимости: float = 0.5

@export var порог_почкования: float = 2.0
@export var материя_зачатка: float = 0.125
@export var направление_роста: Vector3 = Vector3.RIGHT

var накопленная_энергия: float = 0.0
var накопленная_материя: float = 1.0
var зачаток_создан: bool = false
var зачаток: MeshInstance3D


func _ready() -> void:
	material_override = создать_материал(Color(0.2, 0.8, 0.3))
	обновить_размер()


func _process(delta: float) -> void:
	if источник_энергии == null:
		return

	var значение_поля: float = источник_энергии.получить_энергию_в_точке(global_position)

	поглотить_энергию(значение_поля, delta)
	создать_материю(delta)

	if накопленная_материя >= порог_почкования and not зачаток_создан:
		начать_почкование()

	обновить_размер()
	
	обновить_положение_зачатка()

	print(
		"Поле: %.4f | Энергия: %.4f | Материя: %.4f"
		% [значение_поля, накопленная_энергия, накопленная_материя]
	)


func поглотить_энергию(значение_поля: float, delta: float) -> void:
	var энергия_до_потерь: float = 1.0 - (
		(1.0 - накопленная_энергия)
		* exp(-скорость_поглощения * значение_поля * delta)
	)

	var поглощено_из_поля: float = энергия_до_потерь - накопленная_энергия
	var полезная_энергия: float = поглощено_из_поля * кпд_поглощения

	накопленная_энергия += полезная_энергия


func создать_материю(delta: float) -> void:
	var потенциальный_рост: float = базовая_скорость_роста * накопленная_материя * delta

	var стоимость_единицы: float = базовая_стоимость_материи * (
		1.0 + рост_стоимости * maxf(накопленная_материя - 1.0, 0.0)
	)

	var рост_доступный_по_энергии: float = накопленная_энергия / стоимость_единицы
	var фактический_рост: float = minf(потенциальный_рост, рост_доступный_по_энергии)
	var затраченная_энергия: float = фактический_рост * стоимость_единицы

	накопленная_энергия -= затраченная_энергия
	накопленная_материя += фактический_рост


func начать_почкование() -> void:
	if материя_зачатка <= 0.0 or материя_зачатка >= накопленная_материя:
		return

	накопленная_материя -= материя_зачатка

	зачаток = MeshInstance3D.new()
	зачаток.name = "Зачаток"

	var форма := SphereMesh.new()
	зачаток.mesh = форма
	зачаток.material_override = создать_материал(Color(0.2, 0.7, 1.0))

	var размер_родителя: float = размер_из_материи(накопленная_материя)
	var размер_зачатка: float = размер_из_материи(материя_зачатка)
	зачаток.scale = Vector3.ONE * размер_зачатка

	var направление: Vector3 = направление_роста.normalized()
	var расстояние: float = 0.5 * (размер_родителя + размер_зачатка)
	var позиция_зачатка: Vector3 = global_position + направление * расстояние

	var мир := get_parent()
	мир.add_child(зачаток)
	зачаток.global_position = позиция_зачатка

	зачаток_создан = true


func обновить_размер() -> void:
	var относительный_размер: float = размер_из_материи(накопленная_материя)
	scale = Vector3.ONE * относительный_размер


func размер_из_материи(материя: float) -> float:
	return pow(материя, 1.0 / 3.0)


func создать_материал(цвет: Color) -> StandardMaterial3D:
	var материал := StandardMaterial3D.new()
	материал.albedo_color = цвет
	return материал

func обновить_положение_зачатка() -> void:
	if зачаток == null:
		return

	var размер_родителя: float = размер_из_материи(накопленная_материя)
	var размер_зачатка: float = размер_из_материи(материя_зачатка)
	var направление: Vector3 = направление_роста.normalized()
	var расстояние: float = 0.5 * (размер_родителя + размер_зачатка)

	зачаток.global_position = global_position + направление * расстояние
