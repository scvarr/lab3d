class_name ПредставлениеКлетки
extends Node3D

const ФормаКлетки = preload("res://клетка/форма_клетки.gd")

@onready var оболочка: MeshInstance3D = $Оболочка
@onready var диагностика: Node3D = $Диагностика

var генератор_формы := ФормаКлетки.new()


func построить(
	конструкция: КонструкцияКлетки,
	показывать_внутренние_модули: bool,
	показывать_точки_сцепки: bool
) -> bool:
	if конструкция == null:
		push_error("Невозможно построить представление без конструкции клетки.")
		return false

	очистить()

	var новая_форма: ArrayMesh = генератор_формы.построить(
		конструкция.модули,
		конструкция.органика_тела_на_модуль
	)

	if новая_форма == null:
		return false

	оболочка.mesh = новая_форма
	scale = Vector3.ONE * генератор_формы.получить_визуальный_масштаб()

	if показывать_внутренние_модули:
		оболочка.material_override = генератор_формы.создать_материал_прозрачной_клетки()
		диагностика.add_child(
			генератор_формы.создать_визуализацию_модулей()
		)
	else:
		оболочка.material_override = генератор_формы.создать_материал_клетки()

	if показывать_точки_сцепки:
		диагностика.add_child(
			генератор_формы.создать_визуализацию_точек_сцепки()
		)

	return true


func показать_гибель() -> void:
	оболочка.material_override = генератор_формы.создать_материал_гибели()


func получить_локальные_точки_сцепки() -> Array[Vector3]:
	return генератор_формы.получить_точки_сцепки()


func получить_мировые_точки_сцепки() -> Array[Vector3]:
	var мировые_точки: Array[Vector3] = []

	for точка: Vector3 in получить_локальные_точки_сцепки():
		мировые_точки.append(to_global(точка))

	return мировые_точки


func очистить() -> void:
	оболочка.mesh = null
	оболочка.material_override = null

	for ребенок: Node in диагностика.get_children():
		диагностика.remove_child(ребенок)
		ребенок.queue_free()
