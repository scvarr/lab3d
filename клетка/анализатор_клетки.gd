extends RefCounted

const КодыГенов = preload("res://геном/коды_генов.gd")
const ЗаконыКлетки = preload("res://клетка/законы_клетки.gd")


static func рассчитать(модули: Array[Dictionary], органика_тела_на_модуль: float, солнечный_поток: float) -> Dictionary:
	var органика_модулей: float = 0.0
	var суммарная_площадь_поглощения: float = 0.0
	var количество_поглотителей: int = 0

	var количество_накопителей_энергии: int = 0
	var емкость_энергии: float = 0.0
	var утечка_энергии_при_полном_заполнении: float = 0.0
	
	var количество_биосинтезаторов: int = 0
	var суммарная_скорость_биосинтеза: float = 0.0
	var полезная_мощность_биосинтеза: float = 0.0
	
	for модуль: Dictionary in модули:
		var органика: float = модуль["органика"]
		органика_модулей += органика

		if модуль["тип"] == КодыГенов.ПОГЛОТИТЕЛЬ_ЭНЕРГИИ:
			количество_поглотителей += 1
			суммарная_площадь_поглощения += ЗаконыКлетки.площадь_поглотителя_энергии(органика)
			
		if модуль["тип"] == КодыГенов.НАКОПИТЕЛЬ_ЭНЕРГИИ:
			количество_накопителей_энергии += 1
			емкость_энергии += органика
			утечка_энергии_при_полном_заполнении += (
				модуль["коэффициент_утечки"]
				* ЗаконыКлетки.площадь_модуля(органика)
			)
			
		if модуль["тип"] == КодыГенов.БИОСИНТЕЗАТОР:
			количество_биосинтезаторов += 1

			var скорость: float = ЗаконыКлетки.скорость_обработки_синтезатора(органика)
			var кпд: float = ЗаконыКлетки.кпд_синтезатора(органика)

			суммарная_скорость_биосинтеза += скорость
			полезная_мощность_биосинтеза += скорость * кпд
			
	var органика_тела: float = модули.size() * органика_тела_на_модуль
	var структурная_органика: float = органика_модулей + органика_тела
	var общий_кпд_биосинтеза: float = 0.0

	if суммарная_скорость_биосинтеза > 0.0:
		общий_кпд_биосинтеза = (
			полезная_мощность_биосинтеза
			/ суммарная_скорость_биосинтеза
		)
		
	return {
		"количество_функций": модули.size(),
		"количество_поглотителей": количество_поглотителей,
		"органика_модулей": органика_модулей,
		"органика_тела": органика_тела,
		"структурная_органика": структурная_органика,
		"теплоемкость": структурная_органика,
		"суммарная_площадь_поглощения": суммарная_площадь_поглощения,
		"поглощение_при_текущем_потоке": солнечный_поток * суммарная_площадь_поглощения,
		"количество_накопителей_энергии": количество_накопителей_энергии,
		"емкость_энергии": емкость_энергии,
		"утечка_энергии_при_полном_заполнении": утечка_энергии_при_полном_заполнении,
		"количество_биосинтезаторов": количество_биосинтезаторов,
		"скорость_обработки_биосинтеза": суммарная_скорость_биосинтеза,
		"общий_кпд_биосинтеза": общий_кпд_биосинтеза,
		"скорость_создания_органики": (
			полезная_мощность_биосинтеза
			/ ЗаконыКлетки.ЭНЕРГИЯ_НА_ЕДИНИЦУ_ОРГАНИКИ
		),
		"тепловые_потери_биосинтеза": (
			суммарная_скорость_биосинтеза
			- полезная_мощность_биосинтеза
		),
	}
