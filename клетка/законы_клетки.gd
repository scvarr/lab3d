class_name ЗаконыКлетки
extends RefCounted

const МАСШТАБ_НАСЫЩЕНИЯ_СИНТЕЗАТОРА: float = 5.0
const ВРЕМЯ_ОБРАБОТКИ_ЕДИНИЦЫ: float = 100.0
const ЭНЕРГИЯ_НА_ЕДИНИЦУ_ОРГАНИКИ: float = 10.0


static func площадь_модуля(органика: float) -> float:
	return pow(органика, 2.0 / 3.0)


static func площадь_поглотителя_энергии(органика: float) -> float:
	return площадь_модуля(органика)


static func кпд_синтезатора(органика: float) -> float:
	var куб_масштаба: float = pow(МАСШТАБ_НАСЫЩЕНИЯ_СИНТЕЗАТОРА, 3.0)
	var куб_органики: float = pow(органика, 3.0)

	return pow(
		(куб_масштаба + 1.0) / (куб_масштаба + куб_органики),
		1.0 / 3.0
	)


static func скорость_обработки_синтезатора(органика: float) -> float:
	return органика / ВРЕМЯ_ОБРАБОТКИ_ЕДИНИЦЫ
