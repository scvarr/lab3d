extends RefCounted

const КодыМодулей = preload("res://геном/коды_модулей.gd")

const МАСШТАБ_НАСЫЩЕНИЯ_ТРАНСФОРМАТОРА: float = 5.0
const ВРЕМЯ_ОБРАБОТКИ_ЕДИНИЦЫ_ЭНЕРГИИ: float = 100.0
const ЭНЕРГИЯ_НА_ЕДИНИЦУ_ОРГАНИКИ: float = 10.0

var температура: float = 0.0
var органика_модулей: float = 0.0
var органика_тела: float = 0.0

var есть_модуль_поглощения: bool = false
var органика_поглотителя: float = 0.0

var есть_модуль_накопления: bool = false
var органика_накопителя: float = 0.0
var емкость_накопителя: float = 0.0
var энергия_накопителя: float = 0.0
var коэффициент_утечки: float = 0.0

var есть_модуль_трансформации: bool = false
var органика_трансформатора: float = 0.0
var кпд_трансформации: float = 0.0
var скорость_обработки_энергии: float = 0.0


func настроить(список_модулей: Array[Dictionary], органика_на_модуль: float) -> bool:
	сбросить()
	органика_тела = список_модулей.size() * органика_на_модуль
	
	for модуль: Dictionary in список_модулей:
		органика_модулей += модуль["органика"]
		var тип: int = модуль["тип"]

		match тип:
			КодыМодулей.ПОГЛОЩЕНИЕ:
				if есть_модуль_поглощения:
					push_error("Пока поддерживается только один модуль поглощения.")
					return false

				есть_модуль_поглощения = true
				органика_поглотителя = модуль["органика"]

			КодыМодулей.НАКОПЛЕНИЕ:
				if есть_модуль_накопления:
					push_error("Пока поддерживается только один модуль накопления.")
					return false

				есть_модуль_накопления = true
				органика_накопителя = модуль["органика"]
				емкость_накопителя = органика_накопителя
				коэффициент_утечки = модуль["коэффициент_утечки"]
				
			КодыМодулей.ТРАНСФОРМАЦИЯ:
				if есть_модуль_трансформации:
					push_error("Пока поддерживается только один модуль трансформации.")
					return false

				есть_модуль_трансформации = true
				органика_трансформатора = модуль["органика"]
				рассчитать_характеристики_трансформатора()

	if not есть_модуль_поглощения:
		push_error("Клетка не содержит модуля поглощения.")
		return false

	return true


func обновить(delta: float, солнечный_поток: float) -> void:
	if есть_модуль_поглощения:
		поглотить_свет(delta, солнечный_поток)
	трансформировать_энергию(delta, 0.0)
	обработать_утечку(delta)


func получить_общую_органику() -> float:
	return органика_модулей + органика_тела


func поглотить_свет(delta: float, солнечный_поток: float) -> void:
	var площадь_поглощения: float = pow(органика_поглотителя, 2.0 / 3.0)
	var поглощенная_энергия: float = солнечный_поток * площадь_поглощения * delta

	if not есть_модуль_накопления:
		добавить_тепло(поглощенная_энергия)
		return

	var свободная_емкость: float = max(0.0, емкость_накопителя - энергия_накопителя)
	var сохраненная_энергия: float = min(поглощенная_энергия, свободная_емкость)
	var лишняя_энергия: float = поглощенная_энергия - сохраненная_энергия

	энергия_накопителя += сохраненная_энергия
	добавить_тепло(лишняя_энергия)

func рассчитать_характеристики_трансформатора() -> void:
	var куб_масштаба: float = pow(МАСШТАБ_НАСЫЩЕНИЯ_ТРАНСФОРМАТОРА, 3.0)
	var куб_органики: float = pow(органика_трансформатора, 3.0)

	кпд_трансформации = pow(
		(куб_масштаба + 1.0) / (куб_масштаба + куб_органики),
		1.0 / 3.0
	)

	скорость_обработки_энергии = (
		органика_трансформатора
		/ ВРЕМЯ_ОБРАБОТКИ_ЕДИНИЦЫ_ЭНЕРГИИ
	)

	print(
		"Трансформатор: органика %.4f | КПД %.4f | обработка %.4f энергии/с"
		% [
			органика_трансформатора,
			кпд_трансформации,
			скорость_обработки_энергии
		]
	)

func трансформировать_энергию(delta: float, свободное_место_под_органику: float) -> float:
	if not есть_модуль_трансформации:
		return 0.0

	if not есть_модуль_накопления or энергия_накопителя <= 0.0:
		return 0.0

	if свободное_место_под_органику <= 0.0:
		return 0.0

	var предел_по_скорости: float = скорость_обработки_энергии * delta
	var предел_по_месту: float = (
		свободное_место_под_органику
		* ЭНЕРГИЯ_НА_ЕДИНИЦУ_ОРГАНИКИ
		/ кпд_трансформации
	)

	var обработанная_энергия: float = min(энергия_накопителя, предел_по_скорости)
	обработанная_энергия = min(обработанная_энергия, предел_по_месту)

	var полезная_энергия: float = обработанная_энергия * кпд_трансформации
	var тепловые_потери: float = обработанная_энергия - полезная_энергия
	var созданная_органика: float = полезная_энергия / ЭНЕРГИЯ_НА_ЕДИНИЦУ_ОРГАНИКИ

	энергия_накопителя -= обработанная_энергия
	добавить_тепло(тепловые_потери)

	return созданная_органика

func обработать_утечку(delta: float) -> void:
	if not есть_модуль_накопления or энергия_накопителя <= 0.0:
		return

	var заполненность: float = энергия_накопителя / емкость_накопителя
	var площадь_утечки: float = pow(органика_накопителя, 2.0 / 3.0)
	var утечка_в_секунду: float = коэффициент_утечки * площадь_утечки * заполненность
	var утекшая_энергия: float = min(энергия_накопителя, утечка_в_секунду * delta)

	энергия_накопителя -= утекшая_энергия
	добавить_тепло(утекшая_энергия)


func добавить_тепло(энергия: float) -> void:
	if энергия <= 0.0:
		return

	температура += энергия / получить_общую_органику()


func сбросить() -> void:
	температура = 0.0
	органика_тела = 0.0
	органика_модулей = 0.0
	есть_модуль_поглощения = false
	органика_поглотителя = 0.0

	есть_модуль_накопления = false
	органика_накопителя = 0.0
	емкость_накопителя = 0.0
	энергия_накопителя = 0.0
	коэффициент_утечки = 0.0
	
	есть_модуль_трансформации = false
	органика_трансформатора = 0.0
	кпд_трансформации = 0.0
	скорость_обработки_энергии = 0.0
