extends RefCounted

var конструкция: КонструкцияКлетки
var профиль: ПрофильФункций
var состояние: СостояниеКлетки = СостояниеКлетки.new()


func настроить(новая_конструкция: КонструкцияКлетки) -> void:
	конструкция = новая_конструкция
	профиль = конструкция.профиль
	состояние.сбросить()


func обновить(delta: float, солнечный_поток: float) -> void:
	if профиль.количество_поглотителей_энергии > 0:
		поглотить_свет(delta, солнечный_поток)

	var свободное_место_под_органику: float = max(
		0.0,
		профиль.емкость_органики - состояние.свободная_органика
	)

	состояние.свободная_органика += трансформировать_энергию(
		delta,
		свободное_место_под_органику
	)

	var свободное_место_под_термат: float = max(
		0.0,
		профиль.емкость_термата - состояние.термат
	)

	состояние.термат += синтезировать_термат(
		delta,
		свободное_место_под_термат
	)

	обработать_утечку(delta)
	поглотить_тепло_терматом(delta)


func получить_общую_органику() -> float:
	return конструкция.структурная_органика


func поглотить_свет(delta: float, солнечный_поток: float) -> void:
	var поглощенная_энергия: float = (
		солнечный_поток
		* профиль.площадь_поглощения_энергии
		* delta
	)

	if профиль.количество_накопителей_энергии <= 0:
		добавить_тепло(поглощенная_энергия)
		return

	var свободная_емкость: float = max(
		0.0,
		профиль.емкость_энергии - состояние.энергия
	)

	var сохраненная_энергия: float = min(
		поглощенная_энергия,
		свободная_емкость
	)

	var лишняя_энергия: float = поглощенная_энергия - сохраненная_энергия

	состояние.энергия += сохраненная_энергия
	добавить_тепло(лишняя_энергия)


func трансформировать_энергию(delta: float, свободное_место_под_органику: float) -> float:
	if профиль.количество_биосинтезаторов <= 0:
		return 0.0

	if профиль.количество_накопителей_энергии <= 0 or состояние.энергия <= 0.0:
		return 0.0

	if свободное_место_под_органику <= 0.0:
		return 0.0

	var потенциальная_обработка: float = профиль.скорость_биосинтеза * delta
	var потенциально_полезная_энергия: float = (
		профиль.полезная_мощность_биосинтеза
		* delta
	)

	if потенциальная_обработка <= 0.0 or потенциально_полезная_энергия <= 0.0:
		return 0.0

	var доля_нагрузки: float = 1.0
	доля_нагрузки = min(
		доля_нагрузки,
		состояние.энергия / потенциальная_обработка
	)

	var предел_полезной_энергии: float = (
		свободное_место_под_органику
		* ЗаконыКлетки.ЭНЕРГИЯ_НА_ЕДИНИЦУ_ОРГАНИКИ
	)

	доля_нагрузки = min(
		доля_нагрузки,
		предел_полезной_энергии / потенциально_полезная_энергия
	)

	var обработанная_энергия: float = потенциальная_обработка * доля_нагрузки
	var полезная_энергия: float = потенциально_полезная_энергия * доля_нагрузки
	var тепловые_потери: float = обработанная_энергия - полезная_энергия
	var созданная_органика: float = (
		полезная_энергия
		/ ЗаконыКлетки.ЭНЕРГИЯ_НА_ЕДИНИЦУ_ОРГАНИКИ
	)

	состояние.энергия -= обработанная_энергия
	добавить_тепло(тепловые_потери)

	return созданная_органика


func синтезировать_термат(delta: float, свободное_место: float) -> float:
	if профиль.количество_термосинтезаторов <= 0:
		return 0.0

	if профиль.количество_накопителей_термата <= 0 or свободное_место <= 0.0:
		return 0.0

	if состояние.свободная_органика <= 0.0:
		return 0.0

	if профиль.количество_накопителей_энергии <= 0 or состояние.энергия <= 0.0:
		return 0.0

	var потенциальная_обработка: float = профиль.скорость_термосинтеза * delta
	var потенциальный_термат: float = профиль.скорость_создания_термата * delta
	var потенциальные_энергозатраты: float = (
		профиль.мощность_энергозатрат_термосинтеза
		* delta
	)
	var потенциально_полезная_энергия: float = (
		профиль.полезная_мощность_термосинтеза
		* delta
	)

	if (
		потенциальная_обработка <= 0.0
		or потенциальный_термат <= 0.0
		or потенциальные_энергозатраты <= 0.0
	):
		return 0.0

	var доля_нагрузки: float = 1.0
	доля_нагрузки = min(
		доля_нагрузки,
		состояние.свободная_органика / потенциальная_обработка
	)
	доля_нагрузки = min(
		доля_нагрузки,
		свободное_место / потенциальный_термат
	)
	доля_нагрузки = min(
		доля_нагрузки,
		состояние.энергия / потенциальные_энергозатраты
	)

	var обработанная_органика: float = потенциальная_обработка * доля_нагрузки
	var созданный_термат: float = потенциальный_термат * доля_нагрузки
	var затраченная_энергия: float = потенциальные_энергозатраты * доля_нагрузки
	var полезная_энергия: float = потенциально_полезная_энергия * доля_нагрузки
	var тепловые_потери: float = затраченная_энергия - полезная_энергия

	состояние.свободная_органика -= обработанная_органика
	состояние.энергия -= затраченная_энергия
	добавить_тепло(тепловые_потери)

	return созданный_термат


func обработать_утечку(delta: float) -> void:
	if профиль.количество_накопителей_энергии <= 0 or состояние.энергия <= 0.0:
		return

	if профиль.емкость_энергии <= 0.0:
		return

	var заполненность: float = состояние.энергия / профиль.емкость_энергии
	var утечка_в_секунду: float = (
		профиль.утечка_энергии_при_полном_заполнении
		* заполненность
	)

	var утекшая_энергия: float = min(
		состояние.энергия,
		утечка_в_секунду * delta
	)

	состояние.энергия -= утекшая_энергия
	добавить_тепло(утекшая_энергия)


func поглотить_тепло_терматом(delta: float) -> void:
	if состояние.термат <= 0.0 or состояние.температура <= 0.0:
		return

	var свободная_тепловая_емкость: float = max(
		0.0,
		состояние.термат - состояние.поглощенное_тепло_термата
	)

	if свободная_тепловая_емкость <= 0.0:
		return

	var возможное_поглощение: float = (
		состояние.термат
		* состояние.температура
		* ЗаконыКлетки.СКОРОСТЬ_ПОГЛОЩЕНИЯ_ТЕПЛА
		* delta
	)

	var поглощенное_тепло: float = min(
		возможное_поглощение,
		свободная_тепловая_емкость
	)

	поглощенное_тепло = min(
		поглощенное_тепло,
		состояние.температура
	)

	состояние.температура -= поглощенное_тепло
	состояние.поглощенное_тепло_термата += поглощенное_тепло


func добавить_тепло(энергия: float) -> void:
	if энергия <= 0.0:
		return

	состояние.температура += энергия / получить_общую_органику()
