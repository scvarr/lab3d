extends RefCounted

const КодыГенов = preload("res://геном/коды_генов.gd")
const МорфологияКлеткиКласс = preload("res://клетка/морфология_клетки.gd")

const ПОРОГ_ПОВЕРХНОСТИ: float = 1.0
const КОЛЬЦА_ФОРМЫ: int = 24
const СЕГМЕНТЫ_ФОРМЫ: int = 48
const ШАГИ_ПОИСКА_ПОВЕРХНОСТИ: int = 18
const ВИЗУАЛЬНЫЙ_МАСШТАБ: float = 0.5

static var кэш_морфологий: Dictionary = {}
static var попадания_в_кэш: int = 0
static var промахи_кэша: int = 0

static var направления_поверхности: PackedVector3Array = PackedVector3Array()
static var индексы_поверхности: PackedInt32Array = PackedInt32Array()
static var направления_упаковки: Array[Vector3] = []


class ДанныеПостроения:
	extends RefCounted

	var модули: Array[ВыраженнаяФункция] = []
	var органика_тела_на_модуль: float = 0.0

	var типы: PackedInt32Array = PackedInt32Array()
	var цвета: PackedColorArray = PackedColorArray()
	var центры: Array[Vector3] = []
	var размеры: Array[Vector3] = []
	var обратные_размеры: Array[Vector3] = []
	var ориентации: Array[Basis] = []
	var обратные_ориентации: Array[Basis] = []
	var условные_радиусы: PackedFloat64Array = PackedFloat64Array()

	var верхняя_граница_поверхности: float = 1.0


static func получить_морфологию(конструкция: КонструкцияКлетки) -> МорфологияКлетки:
	if конструкция == null:
		push_error("Невозможно построить морфологию без конструкции клетки.")
		return null

	if конструкция.модули.is_empty():
		push_error("Невозможно построить морфологию без функций клетки.")
		return null

	var ключ: String = создать_ключ_морфологии(конструкция)

	if кэш_морфологий.has(ключ):
		попадания_в_кэш += 1
		return кэш_морфологий[ключ]

	промахи_кэша += 1
	подготовить_общие_данные()

	var данные: ДанныеПостроения = подготовить_данные_построения(конструкция)

	if получить_поле_формы(Vector3.ZERO, данные) < ПОРОГ_ПОВЕРХНОСТИ:
		push_error("Центр клетки оказался вне общего поля модулей.")
		return null

	var морфология: МорфологияКлетки = построить_морфологию(данные)
	кэш_морфологий[ключ] = морфология
	return морфология


static func очистить_кэш() -> void:
	кэш_морфологий.clear()
	попадания_в_кэш = 0
	промахи_кэша = 0


static func получить_статистику_кэша() -> Dictionary:
	return {
		"морфологий": кэш_морфологий.size(),
		"попаданий": попадания_в_кэш,
		"промахов": промахи_кэша
	}


static func создать_ключ_морфологии(конструкция: КонструкцияКлетки) -> String:
	var данные_ключа: Array = [конструкция.органика_тела_на_модуль]

	for модуль: ВыраженнаяФункция in конструкция.модули:
		var пропорции: Vector3 = модуль.пропорции
		данные_ключа.append(модуль.тип)
		данные_ключа.append(модуль.органика)
		данные_ключа.append(пропорции)

	return Marshalls.raw_to_base64(var_to_bytes(данные_ключа))


static func подготовить_общие_данные() -> void:
	if not направления_поверхности.is_empty():
		return

	направления_поверхности.append(Vector3.UP)

	for кольцо: int in range(1, КОЛЬЦА_ФОРМЫ):
		var угол_широты: float = PI * float(кольцо) / float(КОЛЬЦА_ФОРМЫ)
		var высота: float = cos(угол_широты)
		var радиус_кольца: float = sin(угол_широты)

		for сегмент: int in range(СЕГМЕНТЫ_ФОРМЫ):
			var угол_долготы: float = TAU * float(сегмент) / float(СЕГМЕНТЫ_ФОРМЫ)
			направления_поверхности.append(Vector3(
				радиус_кольца * cos(угол_долготы),
				высота,
				радиус_кольца * sin(угол_долготы)
			))

	направления_поверхности.append(Vector3.DOWN)
	подготовить_индексы_поверхности()

	направления_упаковки = [
		Vector3(1.0, 1.0, 1.0).normalized(),
		Vector3(-1.0, -1.0, 1.0).normalized(),
		Vector3(-1.0, 1.0, -1.0).normalized(),
		Vector3(1.0, -1.0, -1.0).normalized(),
		Vector3.RIGHT,
		Vector3.LEFT,
		Vector3.UP,
		Vector3.DOWN,
		Vector3.FORWARD,
		Vector3.BACK
	]


static func подготовить_индексы_поверхности() -> void:
	var индексы := PackedInt32Array()
	var начало_первого_кольца: int = 1

	for сегмент: int in range(СЕГМЕНТЫ_ФОРМЫ):
		var следующий: int = (сегмент + 1) % СЕГМЕНТЫ_ФОРМЫ
		индексы.append(0)
		индексы.append(начало_первого_кольца + следующий)
		индексы.append(начало_первого_кольца + сегмент)

	for кольцо: int in range(КОЛЬЦА_ФОРМЫ - 2):
		var верхнее_кольцо: int = 1 + кольцо * СЕГМЕНТЫ_ФОРМЫ
		var нижнее_кольцо: int = верхнее_кольцо + СЕГМЕНТЫ_ФОРМЫ

		for сегмент: int in range(СЕГМЕНТЫ_ФОРМЫ):
			var следующий: int = (сегмент + 1) % СЕГМЕНТЫ_ФОРМЫ
			var верхний_текущий: int = верхнее_кольцо + сегмент
			var верхний_следующий: int = верхнее_кольцо + следующий
			var нижний_текущий: int = нижнее_кольцо + сегмент
			var нижний_следующий: int = нижнее_кольцо + следующий

			индексы.append(верхний_текущий)
			индексы.append(верхний_следующий)
			индексы.append(нижний_текущий)
			индексы.append(верхний_следующий)
			индексы.append(нижний_следующий)
			индексы.append(нижний_текущий)

	var начало_последнего_кольца: int = 1 + (КОЛЬЦА_ФОРМЫ - 2) * СЕГМЕНТЫ_ФОРМЫ
	var индекс_южного_полюса: int = направления_поверхности.size() - 1

	for сегмент: int in range(СЕГМЕНТЫ_ФОРМЫ):
		var следующий: int = (сегмент + 1) % СЕГМЕНТЫ_ФОРМЫ
		индексы.append(начало_последнего_кольца + сегмент)
		индексы.append(начало_последнего_кольца + следующий)
		индексы.append(индекс_южного_полюса)

	индексы_поверхности = индексы


static func подготовить_данные_построения(конструкция: КонструкцияКлетки) -> ДанныеПостроения:
	var данные := ДанныеПостроения.new()
	данные.модули = конструкция.модули
	данные.органика_тела_на_модуль = конструкция.органика_тела_на_модуль

	var количество: int = данные.модули.size()
	данные.типы.resize(количество)
	данные.цвета.resize(количество)
	данные.центры.resize(количество)
	данные.размеры.resize(количество)
	данные.обратные_размеры.resize(количество)
	данные.ориентации.resize(количество)
	данные.обратные_ориентации.resize(количество)
	данные.условные_радиусы.resize(количество)

	for номер: int in range(количество):
		var модуль: ВыраженнаяФункция = данные.модули[номер]
		var тип: int = модуль.тип
		var органика_формы: float = модуль.органика + данные.органика_тела_на_модуль
		var базовый_радиус: float = pow(органика_формы, 1.0 / 3.0)
		var размеры: Vector3 = получить_размеры_модуля(модуль, базовый_радиус)

		данные.типы[номер] = тип
		данные.цвета[номер] = получить_цвет_модуля(тип)
		данные.размеры[номер] = размеры
		данные.обратные_размеры[номер] = Vector3(
			1.0 / размеры.x,
			1.0 / размеры.y,
			1.0 / размеры.z
		)
		данные.ориентации[номер] = Basis.IDENTITY
		данные.обратные_ориентации[номер] = Basis.IDENTITY
		данные.условные_радиусы[номер] = max(размеры.x, размеры.y, размеры.z)

	var порядок: Array[int] = получить_порядок_размещения(данные)
	var размещенные: Array[int] = []

	for номер: int in порядок:
		данные.центры[номер] = найти_место_для_модуля(номер, размещенные, данные)

		if данные.типы[номер] == КодыГенов.ПОЧКОВАНИЕ:
			var направление_наружу: Vector3 = данные.центры[номер].normalized()

			if not направление_наружу.is_zero_approx():
				данные.ориентации[номер] = Basis(Quaternion(Vector3.FORWARD, направление_наружу))

		данные.обратные_ориентации[номер] = данные.ориентации[номер].inverse()
		размещенные.append(номер)

	for номер: int in range(количество):
		var возможная_граница: float = данные.центры[номер].length() + данные.условные_радиусы[номер] * 2.0
		данные.верхняя_граница_поверхности = max(данные.верхняя_граница_поверхности, возможная_граница)

	return данные


static func получить_порядок_размещения(данные: ДанныеПостроения) -> Array[int]:
	var порядок: Array[int] = []

	for зона: int in range(3):
		for номер: int in range(данные.типы.size()):
			if получить_зону_модуля(данные.типы[номер]) == зона:
				порядок.append(номер)

	return порядок


static func получить_зону_модуля(тип: int) -> int:
	match тип:
		КодыГенов.НАКОПИТЕЛЬ_ЭНЕРГИИ, КодыГенов.НАКОПИТЕЛЬ_ОРГАНИКИ:
			return 0

		КодыГенов.БИОСИНТЕЗАТОР, КодыГенов.ТЕРМОСИНТЕЗАТОР, КодыГенов.НАКОПИТЕЛЬ_ТЕРМАТА:
			return 1

		КодыГенов.ПОГЛОТИТЕЛЬ_ЭНЕРГИИ, КодыГенов.ПОЧКОВАНИЕ:
			return 2

		_:
			return 1


static func найти_место_для_модуля(номер: int, размещенные: Array[int], данные: ДанныеПостроения) -> Vector3:
	if размещенные.is_empty():
		return Vector3.ZERO

	var лучшее_место := Vector3.ZERO
	var лучшая_дальность: float = INF
	var найдено: bool = false

	for опорный_номер: int in размещенные:
		for направление: Vector3 in направления_упаковки:
			var расстояние: float = (данные.условные_радиусы[опорный_номер] + данные.условные_радиусы[номер]) * 0.72
			var кандидат: Vector3 = данные.центры[опорный_номер] + направление * расстояние

			if место_свободно(номер, кандидат, размещенные, данные):
				var дальность: float = кандидат.length_squared()

				if дальность < лучшая_дальность:
					лучшее_место = кандидат
					лучшая_дальность = дальность
					найдено = true

	if найдено:
		return лучшее_место

	var внешний_радиус: float = 0.0

	for размещенный_номер: int in размещенные:
		внешний_радиус = max(
			внешний_радиус,
			данные.центры[размещенный_номер].length() + данные.условные_радиусы[размещенный_номер]
		)

	return направления_упаковки[размещенные.size() % направления_упаковки.size()] * (
		внешний_радиус + данные.условные_радиусы[номер] * 0.72
	)


static func место_свободно(номер: int, место: Vector3, размещенные: Array[int], данные: ДанныеПостроения) -> bool:
	for размещенный_номер: int in размещенные:
		var минимальное_расстояние: float = (
			данные.условные_радиусы[размещенный_номер]
			+ данные.условные_радиусы[номер]
		) * 0.58

		if место.distance_to(данные.центры[размещенный_номер]) < минимальное_расстояние:
			return false

	return true


static func получить_размеры_модуля(модуль: ВыраженнаяФункция, базовый_радиус: float) -> Vector3:
	var пропорции: Vector3 = модуль.пропорции
	var нормализатор: float = pow(пропорции.x * пропорции.y * пропорции.z, 1.0 / 3.0)
	return пропорции / нормализатор * базовый_радиус


static func получить_влияние_модуля(номер: int, точка: Vector3, данные: ДанныеПостроения) -> float:
	var смещение: Vector3 = данные.обратные_ориентации[номер] * (точка - данные.центры[номер])
	var обратные_размеры: Vector3 = данные.обратные_размеры[номер]
	var x: float = смещение.x * обратные_размеры.x
	var y: float = смещение.y * обратные_размеры.y
	var z: float = смещение.z * обратные_размеры.z
	var квадрат_расстояния: float = x * x + y * y + z * z
	return 1.0 / (квадрат_расстояния + 1.0)


static func получить_поле_формы(точка: Vector3, данные: ДанныеПостроения) -> float:
	var поле: float = 0.0

	for номер: int in range(данные.центры.size()):
		поле += получить_влияние_модуля(номер, точка, данные)

	return поле


static func найти_радиус_поверхности(направление: Vector3, данные: ДанныеПостроения) -> float:
	var нижняя_граница: float = 0.0
	var верхняя_граница: float = данные.верхняя_граница_поверхности
	var попытка: int = 0

	while получить_поле_формы(направление * верхняя_граница, данные) > ПОРОГ_ПОВЕРХНОСТИ and попытка < 8:
		верхняя_граница *= 2.0
		попытка += 1

	for шаг: int in range(ШАГИ_ПОИСКА_ПОВЕРХНОСТИ):
		var середина: float = (нижняя_граница + верхняя_граница) * 0.5
		var поле: float = получить_поле_формы(направление * середина, данные)

		if поле >= ПОРОГ_ПОВЕРХНОСТИ:
			нижняя_граница = середина
		else:
			верхняя_граница = середина

	return (нижняя_граница + верхняя_граница) * 0.5


static func построить_морфологию(данные: ДанныеПостроения) -> МорфологияКлетки:
	var вершины := PackedVector3Array()
	var цвета_вершин := PackedColorArray()
	вершины.resize(направления_поверхности.size())
	цвета_вершин.resize(направления_поверхности.size())

	for номер: int in range(направления_поверхности.size()):
		var направление: Vector3 = направления_поверхности[номер]
		var радиус: float = найти_радиус_поверхности(направление, данные)
		var точка: Vector3 = направление * радиус
		вершины[номер] = точка
		цвета_вершин[номер] = получить_цвет_формы(точка, данные)

	var нормали: PackedVector3Array = рассчитать_нормали(вершины, индексы_поверхности)
	var массивы: Array = []
	массивы.resize(Mesh.ARRAY_MAX)
	массивы[Mesh.ARRAY_VERTEX] = вершины
	массивы[Mesh.ARRAY_NORMAL] = нормали
	массивы[Mesh.ARRAY_COLOR] = цвета_вершин
	массивы[Mesh.ARRAY_INDEX] = индексы_поверхности

	var меш := ArrayMesh.new()
	меш.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, массивы)

	var морфология := МорфологияКлеткиКласс.new() as МорфологияКлетки
	морфология.меш = меш
	морфология.визуальный_масштаб = ВИЗУАЛЬНЫЙ_МАСШТАБ
	морфология.типы_модулей = данные.типы
	морфология.цвета_модулей = данные.цвета
	морфология.центры_модулей = данные.центры
	морфология.размеры_модулей = данные.размеры
	морфология.ориентации_модулей = данные.ориентации
	морфология.точки_сцепки = рассчитать_точки_сцепки(данные)
	return морфология


static func рассчитать_нормали(вершины: PackedVector3Array, индексы: PackedInt32Array) -> PackedVector3Array:
	var нормали := PackedVector3Array()
	нормали.resize(вершины.size())

	for номер: int in range(0, индексы.size(), 3):
		var индекс_a: int = индексы[номер]
		var индекс_b: int = индексы[номер + 1]
		var индекс_c: int = индексы[номер + 2]
		var нормаль: Vector3 = (
			вершины[индекс_b] - вершины[индекс_a]
		).cross(
			вершины[индекс_c] - вершины[индекс_a]
		).normalized()

		нормали[индекс_a] = нормали[индекс_a] + нормаль
		нормали[индекс_b] = нормали[индекс_b] + нормаль
		нормали[индекс_c] = нормали[индекс_c] + нормаль

	for номер: int in range(нормали.size()):
		нормали[номер] = нормали[номер].normalized()

	return нормали


static func рассчитать_точки_сцепки(данные: ДанныеПостроения) -> PackedVector3Array:
	var точки := PackedVector3Array()

	for номер: int in range(данные.типы.size()):
		if данные.типы[номер] != КодыГенов.ПОЧКОВАНИЕ:
			continue

		var направление: Vector3 = данные.центры[номер].normalized()

		if направление.is_zero_approx():
			continue

		var радиус_поверхности: float = найти_радиус_поверхности(направление, данные)
		точки.append(направление * радиус_поверхности)

	return точки


static func получить_цвет_формы(точка: Vector3, данные: ДанныеПостроения) -> Color:
	var красный: float = 0.0
	var зеленый: float = 0.0
	var синий: float = 0.0
	var сумма: float = 0.0

	for номер: int in range(данные.типы.size()):
		var влияние: float = получить_влияние_модуля(номер, точка, данные)
		var цвет: Color = данные.цвета[номер]
		красный += цвет.r * влияние
		зеленый += цвет.g * влияние
		синий += цвет.b * влияние
		сумма += влияние

	if сумма <= 0.0:
		return Color.WHITE

	return Color(красный / сумма, зеленый / сумма, синий / сумма)


static func получить_цвет_модуля(тип: int) -> Color:
	match тип:
		КодыГенов.ПОГЛОТИТЕЛЬ_ЭНЕРГИИ:
			return Color(0.15, 0.85, 0.25)

		КодыГенов.НАКОПИТЕЛЬ_ОРГАНИКИ:
			return Color(0.15, 0.4, 1.0)

		КодыГенов.НАКОПИТЕЛЬ_ЭНЕРГИИ:
			return Color(0.95, 0.55, 0.15)

		КодыГенов.ТЕРМОСИНТЕЗАТОР:
			return Color(0.55, 0.25, 0.85)

		КодыГенов.НАКОПИТЕЛЬ_ТЕРМАТА:
			return Color(0.15, 0.85, 0.85)

		КодыГенов.ПОЧКОВАНИЕ:
			return Color(0.95, 0.25, 0.55)

		_:
			return Color(0.7, 0.7, 0.7)
