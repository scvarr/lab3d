extends RefCounted

const КодыГенов = preload("res://геном/коды_генов.gd")

const ПОРОГ_ПОВЕРХНОСТИ: float = 1.0
const КОЛЬЦА_ФОРМЫ: int = 24
const СЕГМЕНТЫ_ФОРМЫ: int = 48
const ШАГИ_ПОИСКА_ПОВЕРХНОСТИ: int = 18
const ВИЗУАЛЬНЫЙ_МАСШТАБ: float = 0.5

var модули: Array[Dictionary] = []
var центры_модулей: Array[Vector3] = []
var размеры_модулей: Array[Vector3] = []
var ориентации_модулей: Array[Basis] = []

var органика_тела_на_модуль: float = 0.0


func построить(список_модулей: Array[Dictionary], органика_на_модуль: float) -> ArrayMesh:
	модули = список_модулей
	органика_тела_на_модуль = органика_на_модуль
	подготовить_поле_формы()

	if центры_модулей.is_empty():
		push_error("Невозможно построить форму без модулей.")
		return null

	if получить_поле_формы(Vector3.ZERO) < ПОРОГ_ПОВЕРХНОСТИ:
		push_error("Центр клетки оказался вне общего поля модулей.")
		return null

	var инструмент := SurfaceTool.new()
	инструмент.begin(Mesh.PRIMITIVE_TRIANGLES)

	добавить_вершину_формы(инструмент, Vector3.UP)

	for кольцо: int in range(1, КОЛЬЦА_ФОРМЫ):
		var угол_широты: float = PI * float(кольцо) / float(КОЛЬЦА_ФОРМЫ)
		var высота: float = cos(угол_широты)
		var радиус_кольца: float = sin(угол_широты)

		for сегмент: int in range(СЕГМЕНТЫ_ФОРМЫ):
			var угол_долготы: float = TAU * float(сегмент) / float(СЕГМЕНТЫ_ФОРМЫ)
			var направление := Vector3(
				радиус_кольца * cos(угол_долготы),
				высота,
				радиус_кольца * sin(угол_долготы)
			)

			добавить_вершину_формы(инструмент, направление)

	var индекс_южного_полюса: int = 1 + (КОЛЬЦА_ФОРМЫ - 1) * СЕГМЕНТЫ_ФОРМЫ
	добавить_вершину_формы(инструмент, Vector3.DOWN)

	var начало_первого_кольца: int = 1

	for сегмент: int in range(СЕГМЕНТЫ_ФОРМЫ):
		var следующий: int = (сегмент + 1) % СЕГМЕНТЫ_ФОРМЫ

		инструмент.add_index(0)
		инструмент.add_index(начало_первого_кольца + следующий)
		инструмент.add_index(начало_первого_кольца + сегмент)

	for кольцо: int in range(КОЛЬЦА_ФОРМЫ - 2):
		var верхнее_кольцо: int = 1 + кольцо * СЕГМЕНТЫ_ФОРМЫ
		var нижнее_кольцо: int = верхнее_кольцо + СЕГМЕНТЫ_ФОРМЫ

		for сегмент: int in range(СЕГМЕНТЫ_ФОРМЫ):
			var следующий: int = (сегмент + 1) % СЕГМЕНТЫ_ФОРМЫ

			var верхний_текущий: int = верхнее_кольцо + сегмент
			var верхний_следующий: int = верхнее_кольцо + следующий
			var нижний_текущий: int = нижнее_кольцо + сегмент
			var нижний_следующий: int = нижнее_кольцо + следующий

			инструмент.add_index(верхний_текущий)
			инструмент.add_index(верхний_следующий)
			инструмент.add_index(нижний_текущий)

			инструмент.add_index(верхний_следующий)
			инструмент.add_index(нижний_следующий)
			инструмент.add_index(нижний_текущий)

	var начало_последнего_кольца: int = 1 + (КОЛЬЦА_ФОРМЫ - 2) * СЕГМЕНТЫ_ФОРМЫ

	for сегмент: int in range(СЕГМЕНТЫ_ФОРМЫ):
		var следующий: int = (сегмент + 1) % СЕГМЕНТЫ_ФОРМЫ

		инструмент.add_index(начало_последнего_кольца + сегмент)
		инструмент.add_index(начало_последнего_кольца + следующий)
		инструмент.add_index(индекс_южного_полюса)

	инструмент.generate_normals()
	return инструмент.commit()


func получить_визуальный_масштаб() -> float:
	return ВИЗУАЛЬНЫЙ_МАСШТАБ


func создать_материал_клетки() -> StandardMaterial3D:
	var материал := StandardMaterial3D.new()
	материал.vertex_color_use_as_albedo = true
	материал.roughness = 0.7
	return материал


func создать_материал_прозрачной_клетки() -> StandardMaterial3D:
	var материал := создать_материал_клетки()
	материал.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
	материал.albedo_color.a = 0.22
	материал.cull_mode = BaseMaterial3D.CULL_DISABLED
	return материал


func создать_визуализацию_модулей() -> Node3D:
	var контейнер := Node3D.new()
	контейнер.name = "ВнутренниеМодули"

	for номер: int in range(модули.size()):
		var сфера := SphereMesh.new()
		сфера.radius = 1.0
		сфера.height = 2.0
		сфера.radial_segments = 24
		сфера.rings = 12

		var материал := StandardMaterial3D.new()
		var цвет: Color = получить_цвет_модуля(модули[номер]["тип"])
		цвет.a = 0.55

		материал.albedo_color = цвет
		материал.transparency = BaseMaterial3D.TRANSPARENCY_ALPHA
		материал.roughness = 0.45

		var визуальный_модуль := MeshInstance3D.new()
		визуальный_модуль.name = "Модуль_%02d" % номер
		визуальный_модуль.mesh = сфера
		визуальный_модуль.material_override = материал
		визуальный_модуль.position = центры_модулей[номер]
		визуальный_модуль.basis = ориентации_модулей[номер]
		визуальный_модуль.scale = размеры_модулей[номер]

		контейнер.add_child(визуальный_модуль)

	return контейнер


func создать_материал_гибели() -> StandardMaterial3D:
	var материал := StandardMaterial3D.new()
	материал.albedo_color = Color(0.03, 0.03, 0.03)
	материал.roughness = 0.7
	return материал


func подготовить_поле_формы() -> void:
	центры_модулей.clear()
	размеры_модулей.clear()
	ориентации_модулей.clear()

	центры_модулей.resize(модули.size())
	размеры_модулей.resize(модули.size())
	ориентации_модулей.resize(модули.size())

	for номер: int in range(модули.size()):
		var органика_формы: float = модули[номер]["органика"] + органика_тела_на_модуль
		var базовый_радиус: float = pow(органика_формы, 1.0 / 3.0)
		размеры_модулей[номер] = получить_размеры_модуля(модули[номер], базовый_радиус)
		ориентации_модулей[номер] = Basis.IDENTITY

	var порядок: Array[int] = получить_порядок_размещения()
	var размещенные: Array[int] = []
	

	for номер: int in порядок:
		центры_модулей[номер] = найти_место_для_модуля(номер, размещенные)

		if модули[номер]["тип"] == КодыГенов.ПОЧКОВАНИЕ:
			var направление_наружу: Vector3 = центры_модулей[номер].normalized()

			if not направление_наружу.is_zero_approx():
				var поворот := Quaternion(Vector3.FORWARD, направление_наружу)
				ориентации_модулей[номер] = Basis(поворот)

		размещенные.append(номер)


func получить_порядок_размещения() -> Array[int]:
	var порядок: Array[int] = []

	for зона: int in range(3):
		for номер: int in range(модули.size()):
			if получить_зону_модуля(модули[номер]["тип"]) == зона:
				порядок.append(номер)

	return порядок


func получить_зону_модуля(тип: int) -> int:
	match тип:
		КодыГенов.НАКОПИТЕЛЬ_ЭНЕРГИИ, КодыГенов.НАКОПИТЕЛЬ_ОРГАНИКИ:
			return 0

		КодыГенов.БИОСИНТЕЗАТОР, КодыГенов.ТЕРМОСИНТЕЗАТОР, КодыГенов.НАКОПИТЕЛЬ_ТЕРМАТА:
			return 1

		КодыГенов.ПОГЛОТИТЕЛЬ_ЭНЕРГИИ, КодыГенов.ПОЧКОВАНИЕ:
			return 2

		_:
			return 1


func найти_место_для_модуля(номер: int, размещенные: Array[int]) -> Vector3:
	if размещенные.is_empty():
		return Vector3.ZERO

	var направления: Array[Vector3] = получить_направления_упаковки()
	var лучшее_место := Vector3.ZERO
	var лучшая_дальность: float = INF
	var найдено: bool = false

	for опорный_номер: int in размещенные:
		for направление: Vector3 in направления:
			var расстояние: float = (получить_условный_радиус(опорный_номер) + получить_условный_радиус(номер)) * 0.72
			var кандидат: Vector3 = центры_модулей[опорный_номер] + направление * расстояние

			if место_свободно(номер, кандидат, размещенные):
				var дальность: float = кандидат.length_squared()

				if дальность < лучшая_дальность:
					лучшее_место = кандидат
					лучшая_дальность = дальность
					найдено = true

	if найдено:
		return лучшее_место

	var внешний_радиус: float = 0.0

	for размещенный_номер: int in размещенные:
		внешний_радиус = max(
			внешний_радиус,
			центры_модулей[размещенный_номер].length() + получить_условный_радиус(размещенный_номер)
		)

	return направления[размещенные.size() % направления.size()] * (внешний_радиус + получить_условный_радиус(номер) * 0.72)


func место_свободно(номер: int, место: Vector3, размещенные: Array[int]) -> bool:
	for размещенный_номер: int in размещенные:
		var минимальное_расстояние: float = (получить_условный_радиус(размещенный_номер) + получить_условный_радиус(номер)) * 0.58

		if место.distance_to(центры_модулей[размещенный_номер]) < минимальное_расстояние:
			return false

	return true


func получить_условный_радиус(номер: int) -> float:
	var размеры: Vector3 = размеры_модулей[номер]
	return max(размеры.x, размеры.y, размеры.z)


func получить_направления_упаковки() -> Array[Vector3]:
	return [
		Vector3(1.0, 1.0, 1.0).normalized(),
		Vector3(-1.0, -1.0, 1.0).normalized(),
		Vector3(-1.0, 1.0, -1.0).normalized(),
		Vector3(1.0, -1.0, -1.0).normalized(),
		Vector3.RIGHT,
		Vector3.LEFT,
		Vector3.UP,
		Vector3.DOWN,
		Vector3.FORWARD,
		Vector3.BACK
	]


func получить_размеры_модуля(модуль: Dictionary, базовый_радиус: float) -> Vector3:
	var пропорции: Vector3

	if модуль["тип"] == КодыГенов.ПОЧКОВАНИЕ:
		пропорции = модуль["пропорции"]
	else:
		пропорции = получить_пропорции_модуля(модуль["тип"])

	var нормализатор: float = pow(
		пропорции.x * пропорции.y * пропорции.z,
		1.0 / 3.0
	)

	return пропорции / нормализатор * базовый_радиус


func получить_пропорции_модуля(тип: int) -> Vector3:
	match тип:
		КодыГенов.ПОГЛОТИТЕЛЬ_ЭНЕРГИИ:
			return Vector3(1.15, 0.80, 1.10)

		КодыГенов.НАКОПИТЕЛЬ_ЭНЕРГИИ:
			return Vector3(0.95, 1.20, 0.90)

		КодыГенов.НАКОПИТЕЛЬ_ОРГАНИКИ:
			return Vector3(1.05, 1.05, 1.05)

		КодыГенов.БИОСИНТЕЗАТОР:
			return Vector3(1.30, 0.90, 0.85)
		
		КодыГенов.ТЕРМОСИНТЕЗАТОР:
			return Vector3(1.10, 0.90, 1.20)
		
		КодыГенов.НАКОПИТЕЛЬ_ТЕРМАТА:
			return Vector3(1.15, 0.95, 1.15)
		
		_:
			return Vector3.ONE


func получить_влияние_модуля (номер: int, точка: Vector3) -> float:
	var смещение: Vector3 = ориентации_модулей[номер].inverse() * (точка - центры_модулей[номер])
	var размеры: Vector3 = размеры_модулей[номер]
	var нормализованное_расстояние := Vector3(
		смещение.x / размеры.x,
		смещение.y / размеры.y,
		смещение.z / размеры.z
	)
	var квадрат_расстояния: float = нормализованное_расстояние.length_squared()

	return 1.0 / (квадрат_расстояния + 1.0)


func получить_поле_формы(точка: Vector3) -> float:
	var поле: float = 0.0

	for номер: int in range(центры_модулей.size()):
		поле += получить_влияние_модуля(номер, точка)

	return поле


func найти_радиус_поверхности(направление: Vector3) -> float:
	var нижняя_граница: float = 0.0
	var верхняя_граница: float = 1.0

	for номер: int in range(центры_модулей.size()):
		var максимальный_размер: float = max(размеры_модулей[номер].x, размеры_модулей[номер].y, размеры_модулей[номер].z)
		var возможная_граница: float = центры_модулей[номер].length() + максимальный_размер * 2.0
		верхняя_граница = max(верхняя_граница, возможная_граница)

	var попытка: int = 0

	while получить_поле_формы(направление * верхняя_граница) > ПОРОГ_ПОВЕРХНОСТИ and попытка < 8:
		верхняя_граница *= 2.0
		попытка += 1

	for шаг: int in range(ШАГИ_ПОИСКА_ПОВЕРХНОСТИ):
		var середина: float = (нижняя_граница + верхняя_граница) * 0.5
		var поле: float = получить_поле_формы(направление * середина)

		if поле >= ПОРОГ_ПОВЕРХНОСТИ:
			нижняя_граница = середина
		else:
			верхняя_граница = середина

	return (нижняя_граница + верхняя_граница) * 0.5


func добавить_вершину_формы(инструмент: SurfaceTool, направление: Vector3) -> void:
	var радиус: float = найти_радиус_поверхности(направление)
	var точка: Vector3 = направление * радиус

	инструмент.set_color(получить_цвет_формы(точка))
	инструмент.add_vertex(точка)


func получить_цвет_формы(точка: Vector3) -> Color:
	var красный: float = 0.0
	var зеленый: float = 0.0
	var синий: float = 0.0
	var сумма: float = 0.0

	for номер: int in range(модули.size()):
		var влияние: float = получить_влияние_модуля(номер, точка)
		var цвет: Color = получить_цвет_модуля(модули[номер]["тип"])

		красный += цвет.r * влияние
		зеленый += цвет.g * влияние
		синий += цвет.b * влияние
		сумма += влияние

	if сумма <= 0.0:
		return Color.WHITE

	return Color(красный / сумма, зеленый / сумма, синий / сумма)


func получить_цвет_модуля(тип: int) -> Color:
	match тип:
		КодыГенов.ПОГЛОТИТЕЛЬ_ЭНЕРГИИ:
			return Color(0.15, 0.85, 0.25)

		КодыГенов.НАКОПИТЕЛЬ_ОРГАНИКИ:
			return Color(0.15, 0.4, 1.0)

		КодыГенов.НАКОПИТЕЛЬ_ЭНЕРГИИ:
			return Color(0.95, 0.55, 0.15)
			
		КодыГенов.ТЕРМОСИНТЕЗАТОР:
			return Color(0.55, 0.25, 0.85)
			
		КодыГенов.НАКОПИТЕЛЬ_ТЕРМАТА:
			return Color(0.15, 0.85, 0.85)
		
		КодыГенов.ПОЧКОВАНИЕ:
			return Color(0.95, 0.25, 0.55)

		_:
			return Color(0.7, 0.7, 0.7)
