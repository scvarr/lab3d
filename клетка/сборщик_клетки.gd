extends RefCounted

const HexКодек = preload("res://геном/hex_кодек.gd")
const ГенетическийИнтерпретатор = preload("res://геном/генетический_интерпретатор.gd")
const КомпоновщикКлетки = preload("res://клетка/компоновщик_клетки.gd")
const ЗаконыКлетки = preload("res://клетка/законы_клетки.gd")
const СборкаКлеткиКласс = preload("res://клетка/сборка_клетки.gd")


static func собрать_из_hex(геном_hex: String) -> Dictionary:
	var результат_hex: Dictionary = HexКодек.hex_в_байты(геном_hex)

	if результат_hex.has("ошибка"):
		return результат_hex

	var геном: PackedByteArray = результат_hex["байты"]

	if геном.is_empty():
		return {
			"ошибка": "HEX-геном не должен быть пустым."
		}

	var доступные_участки: Array[Dictionary] = [{
		"начало_бита": 0,
		"длина_бит": геном.size() * 8
	}]

	return собрать_из_генома(геном, доступные_участки)


static func собрать_из_hex_с_участками(
	геном_hex: String,
	доступные_участки: Array[Dictionary]
) -> Dictionary:
	var результат_hex: Dictionary = HexКодек.hex_в_байты(геном_hex)

	if результат_hex.has("ошибка"):
		return результат_hex

	return собрать_из_генома(
		результат_hex["байты"],
		доступные_участки
	)


static func собрать_из_генома(
	геном: PackedByteArray,
	доступные_участки: Array[Dictionary]
) -> Dictionary:
	if геном.is_empty():
		return {
			"ошибка": "Геном не должен быть пустым."
		}

	var результат_экспрессии: Dictionary = ГенетическийИнтерпретатор.выразить(
		геном,
		доступные_участки
	)

	if результат_экспрессии.has("ошибка"):
		return результат_экспрессии

	var модули: Array[Dictionary] = результат_экспрессии["выраженные_функции"]

	if модули.is_empty():
		return {
			"ошибка": "Геном не выразил ни одной функции клетки."
		}

	var сборка := СборкаКлеткиКласс.new() as СборкаКлетки
	сборка.полный_геном = геном.duplicate()
	сборка.геном_hex = HexКодек.байты_в_hex(сборка.полный_геном)

	for участок: Dictionary in доступные_участки:
		сборка.доступные_участки.append(участок.duplicate(true))

	сборка.конструкция = КомпоновщикКлетки.собрать(
		модули,
		ЗаконыКлетки.ОРГАНИКА_ТЕЛА_НА_МОДУЛЬ
	)

	return {
		"сборка": сборка
	}
