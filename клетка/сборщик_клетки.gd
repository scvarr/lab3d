extends RefCounted

const HexКодек = preload("res://геном/hex_кодек.gd")
const ГенетическийИнтерпретатор = preload("res://геном/генетический_интерпретатор.gd")
const КомпоновщикКлетки = preload("res://клетка/компоновщик_клетки.gd")
const ЗаконыКлетки = preload("res://клетка/законы_клетки.gd")
const ФормаКлетки = preload("res://клетка/форма_клетки.gd")
const СборкаКлеткиКласс = preload("res://клетка/сборка_клетки.gd")

static var кэш_сборок: Dictionary = {}
static var попадания_в_кэш: int = 0
static var промахи_кэша: int = 0


static func собрать_из_hex(геном_hex: String) -> Dictionary:
	var результат_hex: Dictionary = HexКодек.hex_в_байты(геном_hex)

	if результат_hex.has("ошибка"):
		return результат_hex

	var геном: PackedByteArray = результат_hex["байты"]

	if геном.is_empty():
		return {
			"ошибка": "HEX-геном не должен быть пустым."
		}

	var доступные_участки: Array[Dictionary] = [{
		"начало_бита": 0,
		"длина_бит": геном.size() * 8
	}]

	return собрать_из_генома(геном, доступные_участки)


static func собрать_из_hex_с_участками(геном_hex: String, доступные_участки: Array[Dictionary]) -> Dictionary:
	var результат_hex: Dictionary = HexКодек.hex_в_байты(геном_hex)

	if результат_hex.has("ошибка"):
		return результат_hex

	return собрать_из_генома(результат_hex["байты"], доступные_участки)


static func собрать_из_генома(геном: PackedByteArray, доступные_участки: Array[Dictionary]) -> Dictionary:
	if геном.is_empty():
		return {
			"ошибка": "Геном не должен быть пустым."
		}

	var геном_hex: String = HexКодек.байты_в_hex(геном)
	var ключ_сборки: String = создать_ключ_сборки(геном_hex, доступные_участки)

	if not ключ_сборки.is_empty() and кэш_сборок.has(ключ_сборки):
		попадания_в_кэш += 1
		return {
			"сборка": кэш_сборок[ключ_сборки]
		}

	промахи_кэша += 1

	var результат_экспрессии: Dictionary = ГенетическийИнтерпретатор.выразить(
		геном,
		доступные_участки
	)

	if результат_экспрессии.has("ошибка"):
		return результат_экспрессии

	var модули: Array[Dictionary] = результат_экспрессии["выраженные_функции"]

	if модули.is_empty():
		return {
			"ошибка": "Геном не выразил ни одной функции клетки."
		}

	var конструкция: КонструкцияКлетки = КомпоновщикКлетки.собрать(
		модули,
		ЗаконыКлетки.ОРГАНИКА_ТЕЛА_НА_МОДУЛЬ
	)
	var морфология: МорфологияКлетки = ФормаКлетки.получить_морфологию(конструкция)

	if морфология == null:
		return {
			"ошибка": "Не удалось построить морфологию клетки."
		}

	var сборка := СборкаКлеткиКласс.new() as СборкаКлетки
	сборка.полный_геном = геном.duplicate()
	сборка.геном_hex = геном_hex
	сборка.конструкция = конструкция
	сборка.морфология = морфология

	for участок: Dictionary in доступные_участки:
		сборка.доступные_участки.append(участок.duplicate(true))

	if not ключ_сборки.is_empty():
		кэш_сборок[ключ_сборки] = сборка

	return {
		"сборка": сборка
	}


static func очистить_кэши() -> void:
	кэш_сборок.clear()
	попадания_в_кэш = 0
	промахи_кэша = 0
	ФормаКлетки.очистить_кэш()


static func получить_статистику_кэшей() -> Dictionary:
	var морфология: Dictionary = ФормаКлетки.получить_статистику_кэша()
	return {
		"сборок": кэш_сборок.size(),
		"попаданий_сборок": попадания_в_кэш,
		"промахов_сборок": промахи_кэша,
		"морфологий": морфология["морфологий"],
		"попаданий_морфологий": морфология["попаданий"],
		"промахов_морфологий": морфология["промахов"]
	}


static func создать_ключ_сборки(геном_hex: String, доступные_участки: Array[Dictionary]) -> String:
	var части := PackedStringArray()
	части.append(геном_hex)

	for участок: Dictionary in доступные_участки:
		if not участок.has("начало_бита") or not участок.has("длина_бит"):
			return ""

		части.append("%d:%d" % [
			int(участок["начало_бита"]),
			int(участок["длина_бит"])
		])

	return "|".join(части)
