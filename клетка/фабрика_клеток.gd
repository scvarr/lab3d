extends RefCounted

const СЦЕНА_КЛЕТКИ: PackedScene = preload("res://cell.tscn")
const СборщикКлетки = preload("res://клетка/сборщик_клетки.gd")


static func создать_из_hex(геном_hex: String) -> Dictionary:
	var результат_сборки: Dictionary = СборщикКлетки.собрать_из_hex(геном_hex)

	if результат_сборки.has("ошибка"):
		return результат_сборки

	return создать_из_сборки(результат_сборки["сборка"])


static func создать_из_сборки(сборка: СборкаКлетки) -> Dictionary:
	if сборка == null:
		return {
			"ошибка": "Нельзя создать клетку без готовой сборки."
		}

	var клетка := СЦЕНА_КЛЕТКИ.instantiate() as Клетка

	if клетка == null:
		return {
			"ошибка": "Корневой узел сцены клетки должен использовать скрипт Клетка."
		}

	if not клетка.назначить_сборку(сборка):
		клетка.free()

		return {
			"ошибка": "Клетка не приняла готовую сборку."
		}

	return {
		"клетка": клетка
	}
