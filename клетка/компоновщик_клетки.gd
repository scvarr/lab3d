extends RefCounted

const КодыГенов = preload("res://геном/коды_генов.gd")
const ЗаконыКлетки = preload("res://клетка/законы_клетки.gd")
const КонструкцияКлеткиКласс = preload("res://клетка/конструкция_клетки.gd")


static func собрать(модули: Array[Dictionary], органика_тела_на_модуль: float) -> КонструкцияКлетки:
	var конструкция := КонструкцияКлеткиКласс.new() as КонструкцияКлетки

	for модуль: Dictionary in модули:
		конструкция.модули.append(модуль)

		var органика: float = модуль["органика"]
		var тип: int = модуль["тип"]

		конструкция.органика_модулей += органика

		match тип:
			КодыГенов.ПОГЛОТИТЕЛЬ_ЭНЕРГИИ:
				добавить_поглотитель_энергии(конструкция.профиль, органика)

			КодыГенов.НАКОПИТЕЛЬ_ЭНЕРГИИ:
				добавить_накопитель_энергии(
					конструкция.профиль,
					органика,
					модуль["коэффициент_утечки"]
				)

			КодыГенов.БИОСИНТЕЗАТОР:
				добавить_биосинтезатор(конструкция.профиль, органика)

			КодыГенов.НАКОПИТЕЛЬ_ОРГАНИКИ:
				конструкция.профиль.количество_накопителей_органики += 1

			КодыГенов.ТЕРМОСИНТЕЗАТОР:
				конструкция.профиль.количество_термосинтезаторов += 1

			КодыГенов.НАКОПИТЕЛЬ_ТЕРМАТА:
				конструкция.профиль.количество_накопителей_термата += 1

			КодыГенов.ПОЧКОВАНИЕ:
				конструкция.профиль.количество_мест_почкования += 1

	конструкция.органика_тела = модули.size() * органика_тела_на_модуль
	конструкция.структурная_органика = (
		конструкция.органика_модулей
		+ конструкция.органика_тела
	)

	return конструкция


static func добавить_поглотитель_энергии(профиль: ПрофильФункций, органика: float) -> void:
	профиль.количество_поглотителей_энергии += 1
	профиль.площадь_поглощения_энергии += (
		ЗаконыКлетки.площадь_поглотителя_энергии(органика)
	)


static func добавить_накопитель_энергии(
	профиль: ПрофильФункций,
	органика: float,
	коэффициент_утечки: float
) -> void:
	профиль.количество_накопителей_энергии += 1
	профиль.емкость_энергии += органика
	профиль.утечка_энергии_при_полном_заполнении += (
		коэффициент_утечки
		* ЗаконыКлетки.площадь_модуля(органика)
	)


static func добавить_биосинтезатор(профиль: ПрофильФункций, органика: float) -> void:
	var скорость: float = ЗаконыКлетки.скорость_обработки_синтезатора(органика)
	var кпд: float = ЗаконыКлетки.кпд_синтезатора(органика)

	профиль.количество_биосинтезаторов += 1
	профиль.скорость_биосинтеза += скорость
	профиль.полезная_мощность_биосинтеза += скорость * кпд
