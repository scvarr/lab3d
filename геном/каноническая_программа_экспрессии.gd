static var описания_по_маркеру: Dictionary = {}
static var описания_по_типу_функции: Dictionary = {}
static var длины_по_маркеру: Dictionary = {}


static func _static_init() -> void:
	for описание: Dictionary in ОПИСАНИЯ_ФУНКЦИЙ:
		var маркер: int = int(описание["маркер"])
		var тип_функции: int = int(описание["тип_функции"])

		if описания_по_маркеру.has(маркер):
			push_error("Повторное описание маркера 0x%02X." % маркер)
			continue

		if описания_по_типу_функции.has(тип_функции):
			push_error("Повторное описание функции типа 0x%02X." % тип_функции)
			continue

		var длина_байт: int = рассчитать_длину_функции(описание)

		if длина_байт <= 0:
			continue

		описания_по_маркеру[маркер] = описание
		описания_по_типу_функции[тип_функции] = описание
		длины_по_маркеру[маркер] = длина_байт


static func найти_по_маркеру(маркер: int) -> Dictionary:
	if описания_по_маркеру.has(маркер):
		return описания_по_маркеру[маркер]

	return {}


static func найти_по_типу_функции(тип_функции: int) -> Dictionary:
	if описания_по_типу_функции.has(тип_функции):
		return описания_по_типу_функции[тип_функции]

	return {}


static func получить_длину_по_маркеру(маркер: int) -> int:
	return int(длины_по_маркеру.get(маркер, 0))


static func рассчитать_длину_функции(описание: Dictionary) -> int:
	var длина_байт: int = 1

	for поле: Dictionary in описание["поля"]:
		match поле["тип_данных"]:
			ТИП_UINT16:
				длина_байт += 2

			ТИП_VECTOR3_UINT16:
				длина_байт += 6

			_:
				push_error("Неизвестный тип данных поля «%s»." % поле["название"])
				return 0

	return длина_байт
