extends RefCounted

const КаноническаяПрограммаЭкспрессии = preload("res://геном/каноническая_программа_экспрессии.gd")
const ВыраженнаяФункцияКласс = preload("res://геном/выраженная_функция.gd")


static func выразить(геном: PackedByteArray, доступные_участки: Array[Dictionary]) -> Dictionary:
	var результат_нормализации: Dictionary = нормализовать_участки(геном.size(), доступные_участки)

	if результат_нормализации.has("ошибка"):
		return результат_нормализации

	var участки: Array[Vector2i] = результат_нормализации["участки"]
	return выразить_из_нормализованных_участков(геном, участки)


static func нормализовать_участки(размер_генома_байт: int, доступные_участки: Array[Dictionary]) -> Dictionary:
	var участки: Array[Vector2i] = []
	var размер_генома_бит: int = размер_генома_байт * 8

	for участок: Dictionary in доступные_участки:
		if not участок.has("начало_бита") or not участок.has("длина_бит"):
			return {
				"ошибка": "Доступный участок должен содержать начало_бита и длина_бит."
			}

		if typeof(участок["начало_бита"]) != TYPE_INT or typeof(участок["длина_бит"]) != TYPE_INT:
			return {
				"ошибка": "Начало и длина доступного участка должны быть целыми числами."
			}

		var начало_бита: int = участок["начало_бита"]
		var длина_бит: int = участок["длина_бит"]

		if начало_бита < 0 or длина_бит <= 0:
			return {
				"ошибка": "Начало доступного участка не может быть отрицательным, а длина должна быть больше нуля."
			}

		if начало_бита % 8 != 0 or длина_бит % 8 != 0:
			return {
				"ошибка": "Доступные участки пока должны быть выровнены по границам байтов."
			}

		if начало_бита + длина_бит > размер_генома_бит:
			return {
				"ошибка": "Доступный участок выходит за границы генома."
			}

		участки.append(Vector2i(начало_бита, длина_бит))

	участки.sort_custom(сравнить_участки)

	var объединенные: Array[Vector2i] = []

	for участок: Vector2i in участки:
		if объединенные.is_empty():
			объединенные.append(участок)
			continue

		var последний_номер: int = объединенные.size() - 1
		var последний: Vector2i = объединенные[последний_номер]
		var последний_конец: int = последний.x + последний.y
		var текущий_конец: int = участок.x + участок.y

		if участок.x < последний_конец:
			объединенные[последний_номер] = Vector2i(
				последний.x,
				max(последний_конец, текущий_конец) - последний.x
			)
		else:
			объединенные.append(участок)

	return {
		"участки": объединенные
	}


static func выразить_из_нормализованных_участков(геном: PackedByteArray, участки: Array[Vector2i]) -> Dictionary:
	var выраженные_функции: Array[ВыраженнаяФункция] = []

	for участок: Vector2i in участки:
		var начало_байта: int = участок.x >> 3
		var конец_байта: int = начало_байта + (участок.y >> 3)
		var позиция: int = начало_байта

		while позиция < конец_байта:
			var маркер: int = геном[позиция]
			var описание: Dictionary = КаноническаяПрограммаЭкспрессии.найти_по_маркеру(маркер)

			if описание.is_empty():
				позиция += 1
				continue

			var длина_функции: int = КаноническаяПрограммаЭкспрессии.получить_длину_по_маркеру(маркер)

			if длина_функции <= 0 or позиция + длина_функции > конец_байта:
				позиция += 1
				continue

			var функция := ВыраженнаяФункцияКласс.new() as ВыраженнаяФункция
			функция.тип = int(описание["тип_функции"])

			var курсор: int = позиция + 1
			var корректно: bool = true
			var есть_органика: bool = false
			var есть_пропорции: bool = false

			for поле: Dictionary in описание["поля"]:
				var имя := StringName(поле["имя"])
				var значение: Variant

				match поле["тип_данных"]:
					КаноническаяПрограммаЭкспрессии.ТИП_UINT16:
						var сырое_значение: int = (геном[курсор] << 8) | геном[курсор + 1]
						значение = сырое_значение / float(поле["масштаб"])
						курсор += 2

						if float(значение) < float(поле["минимум"]):
							корректно = false
							break

					КаноническаяПрограммаЭкспрессии.ТИП_VECTOR3_UINT16:
						var масштаб: float = float(поле["масштаб"])
						значение = Vector3(
							((геном[курсор] << 8) | геном[курсор + 1]) / масштаб,
							((геном[курсор + 2] << 8) | геном[курсор + 3]) / масштаб,
							((геном[курсор + 4] << 8) | геном[курсор + 5]) / масштаб
						)
						курсор += 6

						var минимум: float = float(поле["минимум"])
						var вектор: Vector3 = значение

						if вектор.x < минимум or вектор.y < минимум or вектор.z < минимум:
							корректно = false
							break

					_:
						корректно = false
						break

				match имя:
					&"органика":
						if typeof(значение) != TYPE_FLOAT:
							корректно = false
							break

						функция.органика = float(значение)
						есть_органика = true

					&"пропорции":
						if typeof(значение) != TYPE_VECTOR3:
							корректно = false
							break

						var вектор_значения: Vector3 = значение
						функция.пропорции = вектор_значения
						есть_пропорции = true

					_:
						функция.установить_параметр(имя, значение)

			if not корректно or not есть_органика or not есть_пропорции:
				позиция += 1
				continue

			функция.участки_генома.append(Vector2i(
				позиция * 8,
				(курсор - позиция) * 8
			))
			выраженные_функции.append(функция)
			позиция = курсор

	return {
		"выраженные_функции": выраженные_функции
	}


static func сравнить_участки(левый: Vector2i, правый: Vector2i) -> bool:
	if левый.x == правый.x:
		return левый.y < правый.y

	return левый.x < правый.x
