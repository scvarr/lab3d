extends RefCounted

const КодыГенов = preload("res://геном/коды_генов.gd")
const ПоглотительЭнергии = preload("res://гены/поглотитель_энергии.gd")
const НакопительЭнергии = preload("res://гены/накопитель_энергии.gd")
const Биосинтезатор = preload("res://гены/биосинтезатор.gd")
const НакопительОрганики = preload("res://гены/накопитель_органики.gd")
const Термосинтезатор = preload("res://гены/термосинтезатор.gd")
const НакопительТермата = preload("res://гены/накопитель_термата.gd")

static func прочитать(геном: String) -> Dictionary:
	var модули: Array[Dictionary] = []

	for текст_гена in геном.split(";"):
		var ген: String = текст_гена.strip_edges()

		if ген.is_empty():
			continue

		var части: PackedStringArray = ген.split(",")
		var код: String = части[0].strip_edges().to_upper()

		if код.length() != 2 or not код.is_valid_hex_number():
			return {
				"ошибка": "Некорректный код гена: '%s'" % код
			}

		var код_гена: int = код.hex_to_int()
		var результат: Dictionary = {}

		match код_гена:
			КодыГенов.ПОГЛОТИТЕЛЬ_ЭНЕРГИИ:
				результат = ПоглотительЭнергии.прочитать(части)
			КодыГенов.НАКОПИТЕЛЬ_ЭНЕРГИИ:
				результат = НакопительЭнергии.прочитать(части)
			КодыГенов.БИОСИНТЕЗАТОР:
				результат = Биосинтезатор.прочитать(части)
			КодыГенов.НАКОПИТЕЛЬ_ОРГАНИКИ:
				результат = НакопительОрганики.прочитать(части)
			КодыГенов.ТЕРМОСИНТЕЗАТОР:
				результат = Термосинтезатор.прочитать(части)
			КодыГенов.НАКОПИТЕЛЬ_ТЕРМАТА:
				результат = НакопительТермата.прочитать(части)
			_:
				return {
					"ошибка": "Среда не умеет развивать модуль с кодом %s." % код
				}
			
		if результат.has("ошибка"):
			return результат

		модули.append(результат)

	if модули.is_empty():
		return {
			"ошибка": "Геном не содержит распознанных генов."
		}

	return {
		"модули": модули
	}
