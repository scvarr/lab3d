extends RefCounted

const КаноническаяПрограммаЭкспрессии = preload("res://геном/каноническая_программа_экспрессии.gd")


static func скомпилировать(описание_клетки: Array[ВыраженнаяФункция]) -> Dictionary:
	var геном := PackedByteArray()

	for номер: int in range(описание_клетки.size()):
		var функция: ВыраженнаяФункция = описание_клетки[номер]

		if функция == null:
			return {
				"ошибка": "Функция с номером %d не задана." % номер
			}

		var описание: Dictionary = КаноническаяПрограммаЭкспрессии.найти_по_типу_функции(функция.тип)

		if описание.is_empty():
			return {
				"ошибка": "Компилятор не знает функцию типа %s." % функция.тип
			}

		var результат: Dictionary = закодировать_функцию(функция, описание)

		if результат.has("ошибка"):
			return {
				"ошибка": "Функция %d: %s" % [номер, результат["ошибка"]]
			}

		геном.append_array(результат["байты"])

	return {
		"геном": геном
	}


static func закодировать_функцию(функция: ВыраженнаяФункция, описание: Dictionary) -> Dictionary:
	var байты := PackedByteArray()
	байты.append(описание["маркер"])

	for поле: Dictionary in описание["поля"]:
		var имя := StringName(поле["имя"])

		if not функция.содержит_поле(имя):
			return {
				"ошибка": "Для функции «%s» не задан параметр «%s»." % [
					описание["название"],
					поле["название"]
				]
			}

		var значение: Variant = функция.получить_значение_поля(имя)
		var результат_поля: Dictionary = закодировать_поле(значение, поле, описание)

		if результат_поля.has("ошибка"):
			return результат_поля

		байты.append_array(результат_поля["байты"])

	return {
		"байты": байты
	}


static func закодировать_поле(значение: Variant, поле: Dictionary, описание: Dictionary) -> Dictionary:
	var масштаб: float = float(поле["масштаб"])
	var минимум: float = float(поле["минимум"])

	match поле["тип_данных"]:
		КаноническаяПрограммаЭкспрессии.ТИП_UINT16:
			var тип_значения: int = typeof(значение)

			if тип_значения != TYPE_INT and тип_значения != TYPE_FLOAT:
				return ошибка_типа(поле, описание, "число")

			var число: float = float(значение)

			if not is_finite(число):
				return ошибка_диапазона(поле, описание, "должен быть конечным числом")

			if число < минимум:
				return ошибка_диапазона(поле, описание, "меньше допустимого значения %s" % минимум)

			var сырое_значение: int = roundi(число * масштаб)

			if сырое_значение < 0 or сырое_значение > 0xFFFF:
				return ошибка_диапазона(поле, описание, "не помещается в uint16")

			return {
				"байты": PackedByteArray([
					(сырое_значение >> 8) & 0xFF,
					сырое_значение & 0xFF
				])
			}

		КаноническаяПрограммаЭкспрессии.ТИП_VECTOR3_UINT16:
			if typeof(значение) != TYPE_VECTOR3:
				return ошибка_типа(поле, описание, "Vector3")

			var вектор: Vector3 = значение

			if not вектор.is_finite():
				return ошибка_диапазона(поле, описание, "должен содержать только конечные компоненты")

			if вектор.x < минимум or вектор.y < минимум or вектор.z < минимум:
				return ошибка_диапазона(поле, описание, "содержит компонент меньше %s" % минимум)

			var байты := PackedByteArray()

			for компонент: float in [вектор.x, вектор.y, вектор.z]:
				var сырое_значение: int = roundi(компонент * масштаб)

				if сырое_значение < 0 or сырое_значение > 0xFFFF:
					return ошибка_диапазона(поле, описание, "содержит компонент, не помещающийся в uint16")

				байты.append((сырое_значение >> 8) & 0xFF)
				байты.append(сырое_значение & 0xFF)

			return {
				"байты": байты
			}

		_:
			return {
				"ошибка": "Неизвестный тип данных параметра «%s»." % поле["название"]
			}


static func ошибка_типа(поле: Dictionary, описание: Dictionary, ожидаемый_тип: String) -> Dictionary:
	return {
		"ошибка": "Параметр «%s» функции «%s» должен иметь тип %s." % [
			поле["название"],
			описание["название"],
			ожидаемый_тип
		]
	}


static func ошибка_диапазона(поле: Dictionary, описание: Dictionary, причина: String) -> Dictionary:
	return {
		"ошибка": "Параметр «%s» функции «%s» %s." % [
			поле["название"],
			описание["название"],
			причина
		]
	}
