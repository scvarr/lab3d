extends RefCounted

const КаноническаяПрограммаЭкспрессии = preload("res://геном/каноническая_программа_экспрессии.gd")


static func скомпилировать(описание_клетки: Array[Dictionary]) -> Dictionary:
	var геном := PackedByteArray()

	for номер: int in range(описание_клетки.size()):
		var функция: Dictionary = описание_клетки[номер]

		if not функция.has("тип"):
			return {
				"ошибка": "У функции с номером %d отсутствует тип." % номер
			}

		var описание: Dictionary = КаноническаяПрограммаЭкспрессии.найти_по_типу_функции(функция["тип"])

		if описание.is_empty():
			return {
				"ошибка": "Компилятор не знает функцию типа %s." % функция["тип"]
			}

		var результат: Dictionary = закодировать_функцию(функция, описание)

		if результат.has("ошибка"):
			return результат

		геном.append_array(результат["байты"])

	return {
		"геном": геном
	}


static func закодировать_функцию(функция: Dictionary, описание: Dictionary) -> Dictionary:
	var байты := PackedByteArray()
	байты.append(описание["маркер"])

	for поле: Dictionary in описание["поля"]:
		var имя: String = поле["имя"]

		if not функция.has(имя):
			return {
				"ошибка": "Для функции «%s» не задан параметр «%s»." % [
					описание["название"],
					поле["название"]
				]
			}

		var масштаб: float = float(поле["масштаб"])
		var минимум: float = float(поле["минимум"])

		match поле["тип_данных"]:
			КаноническаяПрограммаЭкспрессии.ТИП_UINT16:
				var значение: float = float(функция[имя])

				if значение < минимум:
					return {
						"ошибка": "Параметр «%s» функции «%s» меньше допустимого значения." % [
							поле["название"],
							описание["название"]
						]
					}

				var сырое_значение: int = roundi(значение * масштаб)

				if сырое_значение > 0xFFFF:
					return {
						"ошибка": "Параметр «%s» функции «%s» не помещается в uint16." % [
							поле["название"],
							описание["название"]
						]
					}

				байты.append((сырое_значение >> 8) & 0xFF)
				байты.append(сырое_значение & 0xFF)

			КаноническаяПрограммаЭкспрессии.ТИП_VECTOR3_UINT16:
				var значение: Vector3 = функция[имя]

				if значение.x < минимум or значение.y < минимум or значение.z < минимум:
					return {
						"ошибка": "Компоненты параметра «%s» функции «%s» должны быть не меньше %s." % [
							поле["название"],
							описание["название"],
							минимум
						]
					}

				var компоненты: Array[float] = [значение.x, значение.y, значение.z]

				for компонент: float in компоненты:
					var сырое_значение: int = roundi(компонент * масштаб)

					if сырое_значение > 0xFFFF:
						return {
							"ошибка": "Компонент параметра «%s» функции «%s» не помещается в uint16." % [
								поле["название"],
								описание["название"]
							]
						}

					байты.append((сырое_значение >> 8) & 0xFF)
					байты.append(сырое_значение & 0xFF)

			_:
				return {
					"ошибка": "Неизвестный тип данных параметра «%s»." % поле["название"]
				}

	return {
		"байты": байты
	}
