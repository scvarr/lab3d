extends Node

const HexКодек = preload("res://геном/hex_кодек.gd")
const ГенетическийИнтерпретатор = preload("res://геном/генетический_интерпретатор.gd")
const КаноническийКомпиляторГенома = preload("res://геном/канонический_компилятор_генома.gd")
const КодыГенов = preload("res://геном/коды_генов.gd")

const АнализаторКлетки = preload("res://клетка/анализатор_клетки.gd")
const КомпоновщикКлетки = preload("res://клетка/компоновщик_клетки.gd")
const ЭнергетикаКлетки = preload("res://клетка/энергетика_клетки.gd")
const ФормаКлетки = preload("res://клетка/форма_клетки.gd")

const ЭТАЛОННЫЙ_HEX: String = "0103E8047E0320044C02138803B604B003840064030FA0051403840352041388041A041A041A0507D0044C038404B0060BB8047E03B6047E0703E803E803E801900703E803E803E801900703E803E803E80190"

const ОРГАНИКА_ТЕЛА_НА_МОДУЛЬ: float = 1.0
const СОЛНЕЧНЫЙ_ПОТОК: float = 0.1
const ПОГРЕШНОСТЬ: float = 0.000001

@export var запускать_проверку: bool = true
@export var остановить_сцену_после_проверки: bool = true

var количество_ошибок: int = 0


func _ready() -> void:
	if not запускать_проверку:
		return

	выполнить_проверку()

	if остановить_сцену_после_проверки:
		get_tree().paused = true


func выполнить_проверку() -> void:
	количество_ошибок = 0

	print("\n========== R0: ФИКСАЦИЯ ТЕКУЩЕГО ПОВЕДЕНИЯ ==========")

	var результат_hex: Dictionary = HexКодек.hex_в_байты(ЭТАЛОННЫЙ_HEX)

	if результат_hex.has("ошибка"):
		зарегистрировать_ошибку(результат_hex["ошибка"])
		завершить_отчет()
		return

	var геном: PackedByteArray = результат_hex["байты"]
	var результат_экспрессии: Dictionary = выразить_весь_геном(геном)

	if результат_экспрессии.has("ошибка"):
		зарегистрировать_ошибку(результат_экспрессии["ошибка"])
		завершить_отчет()
		return

	var модули: Array[Dictionary] = результат_экспрессии["выраженные_функции"]

	вывести_генетический_отчет(геном, модули)
	проверить_компиляцию(геном, модули)
	проверить_участки_и_повреждения(геном)
	вывести_статические_характеристики(модули)
	вывести_результат_одного_такта(модули)
	вывести_геометрию(модули)
	проверить_повторения_функций(модули)

	завершить_отчет()


func выразить_весь_геном(геном: PackedByteArray) -> Dictionary:
	var доступные_участки: Array[Dictionary] = [{
		"начало_бита": 0,
		"длина_бит": геном.size() * 8
	}]

	return ГенетическийИнтерпретатор.выразить(геном, доступные_участки)


func вывести_генетический_отчет(геном: PackedByteArray, модули: Array[Dictionary]) -> void:
	print("\n--- Геном и экспрессия ---")
	print("Байт в геноме: %d" % геном.size())
	print("Выраженных функций: %d" % модули.size())
	print("Типы: 01=%d | 02=%d | 03=%d | 04=%d | 05=%d | 06=%d | 07=%d" % [
		посчитать_тип(модули, КодыГенов.ПОГЛОТИТЕЛЬ_ЭНЕРГИИ),
		посчитать_тип(модули, КодыГенов.НАКОПИТЕЛЬ_ЭНЕРГИИ),
		посчитать_тип(модули, КодыГенов.БИОСИНТЕЗАТОР),
		посчитать_тип(модули, КодыГенов.НАКОПИТЕЛЬ_ОРГАНИКИ),
		посчитать_тип(модули, КодыГенов.ТЕРМОСИНТЕЗАТОР),
		посчитать_тип(модули, КодыГенов.НАКОПИТЕЛЬ_ТЕРМАТА),
		посчитать_тип(модули, КодыГенов.ПОЧКОВАНИЕ)
	])

	проверить_целое(геном.size(), 83, "Размер эталонного генома")
	проверить_целое(модули.size(), 9, "Количество выраженных функций")
	проверить_целое(посчитать_тип(модули, КодыГенов.ПОЧКОВАНИЕ), 3, "Количество функций почкования")


func проверить_компиляцию(геном: PackedByteArray, модули: Array[Dictionary]) -> void:
	print("\n--- Повторная компиляция ---")

	var результат: Dictionary = КаноническийКомпиляторГенома.скомпилировать(модули)

	if результат.has("ошибка"):
		зарегистрировать_ошибку("Повторная компиляция: %s" % результат["ошибка"])
		return

	var скомпилированный_геном: PackedByteArray = результат["геном"]
	var совпадает: bool = скомпилированный_геном == геном

	print("Компиляция выраженных функций возвращает исходный геном: %s" % совпадает)
	проверить(совпадает, "Двоичный геном после повторной компиляции не изменился")


func проверить_участки_и_повреждения(геном: PackedByteArray) -> void:
	print("\n--- Доступные участки и повреждения ---")

	var первые_72_бита: Array[Dictionary] = [{
		"начало_бита": 0,
		"длина_бит": 72
	}]

	var результат_72: Dictionary = ГенетическийИнтерпретатор.выразить(геном, первые_72_бита)

	if результат_72.has("ошибка"):
		зарегистрировать_ошибку("Экспрессия первых 72 бит: %s" % результат_72["ошибка"])
	else:
		var функции_72: Array[Dictionary] = результат_72["выраженные_функции"]
		print("Функций из первых 72 бит: %d" % функции_72.size())
		проверить_целое(функции_72.size(), 1, "Первые 72 бита выражают одну функцию")

	var поврежденный_геном: PackedByteArray = геном.duplicate()
	поврежденный_геном.resize(поврежденный_геном.size() - 1)

	var результат_повреждения: Dictionary = выразить_весь_геном(поврежденный_геном)

	if результат_повреждения.has("ошибка"):
		зарегистрировать_ошибку("Повреждённый хвост: %s" % результат_повреждения["ошибка"])
	else:
		var поврежденные_функции: Array[Dictionary] = результат_повреждения["выраженные_функции"]
		print("Функций после удаления последнего байта: %d" % поврежденные_функции.size())
		print("Функций почкования после повреждения: %d" % посчитать_тип(поврежденные_функции, КодыГенов.ПОЧКОВАНИЕ))

		проверить_целое(поврежденные_функции.size(), 8, "Неполная последняя функция игнорируется")
		проверить_целое(посчитать_тип(поврежденные_функции, КодыГенов.ПОЧКОВАНИЕ), 2, "После повреждения остаются две функции почкования")

	var геном_с_мусором: PackedByteArray = геном.duplicate()
	геном_с_мусором.append_array(PackedByteArray([0xFF, 0xAA, 0x00]))

	var результат_мусора: Dictionary = выразить_весь_геном(геном_с_мусором)

	if результат_мусора.has("ошибка"):
		зарегистрировать_ошибку("Мусорный хвост: %s" % результат_мусора["ошибка"])
	else:
		var функции_с_мусором: Array[Dictionary] = результат_мусора["выраженные_функции"]
		print("Функций после добавления неизвестных байтов: %d" % функции_с_мусором.size())
		проверить_целое(функции_с_мусором.size(), 9, "Неизвестные байты не изменяют предыдущую экспрессию")


func вывести_статические_характеристики(модули: Array[Dictionary]) -> void:
	print("\n--- Статические характеристики ---")

	var конструкция: КонструкцияКлетки = КомпоновщикКлетки.собрать(
		модули,
		ОРГАНИКА_ТЕЛА_НА_МОДУЛЬ
	)

	var профиль: ПрофильФункций = конструкция.профиль
	var характеристики: Dictionary = АнализаторКлетки.рассчитать(
		конструкция,
		СОЛНЕЧНЫЙ_ПОТОК
	)

	var энергетика := ЭнергетикаКлетки.new()
	энергетика.настроить(конструкция)

	print("Органика модулей: %.9f" % характеристики["органика_модулей"])
	print("Органика тела: %.9f" % характеристики["органика_тела"])
	print("Структурная органика: %.9f" % характеристики["структурная_органика"])
	print("Площадь поглощения: %.9f" % профиль.площадь_поглощения_энергии)
	print("Поглощение при потоке 0.1: %.9f энергии/с" % характеристики["поглощение_при_текущем_потоке"])
	print("Ёмкость энергии: %.9f" % профиль.емкость_энергии)
	print("Утечка при полном заполнении: %.9f энергии/с" % профиль.утечка_энергии_при_полном_заполнении)
	print("Скорость биосинтеза: %.9f энергии/с" % профиль.скорость_биосинтеза)
	print("Полезная мощность биосинтеза: %.9f энергии/с" % профиль.полезная_мощность_биосинтеза)
	print("Ёмкость органики: %.9f" % профиль.емкость_органики)
	print("КПД термосинтеза: %.9f" % профиль.получить_общий_кпд_термосинтеза())
	print("Скорость термосинтеза: %.9f органики/с" % профиль.скорость_термосинтеза)
	print("Энергозатраты термосинтеза: %.9f энергии/с" % профиль.мощность_энергозатрат_термосинтеза)
	print("Создание термата: %.9f термата/с" % профиль.скорость_создания_термата)
	print("Ёмкость термата: %.9f" % профиль.емкость_термата)

	проверить(энергетика.профиль == профиль, "Энергетика использует готовый профиль")
	проверить_близко(характеристики["органика_модулей"], 23.0, "Органика модулей")
	проверить_близко(характеристики["органика_тела"], 9.0, "Органика тела")
	проверить_близко(характеристики["структурная_органика"], 32.0, "Структурная органика")
	проверить_близко(профиль.площадь_поглощения_энергии, 1.0, "Площадь поглощения")
	проверить_близко(профиль.емкость_энергии, 5.0, "Ёмкость энергии")
	проверить_близко(профиль.утечка_энергии_при_полном_заполнении, 0.029240177, "Утечка энергии")
	проверить_близко(профиль.скорость_биосинтеза, 0.04, "Скорость биосинтеза")
	проверить_близко(профиль.полезная_мощность_биосинтеза, 0.034943219, "Полезная мощность биосинтеза")
	проверить_близко(профиль.емкость_органики, 11.180339887, "Ёмкость органики")
	проверить_близко(профиль.получить_общий_кпд_термосинтеза(), 0.982139025, "КПД термосинтеза")
	проверить_близко(профиль.скорость_термосинтеза, 0.02, "Скорость термосинтеза")
	проверить_близко(профиль.мощность_энергозатрат_термосинтеза, 0.020363716, "Энергозатраты термосинтеза")
	проверить_близко(профиль.скорость_создания_термата, 0.06, "Скорость создания термата")
	проверить_близко(профиль.емкость_термата, 5.196152423, "Ёмкость термата")


func вывести_результат_одного_такта(модули: Array[Dictionary]) -> void:
	print("\n--- Состояние после одного такта delta=1.0 ---")

	var конструкция: КонструкцияКлетки = КомпоновщикКлетки.собрать(
		модули,
		ОРГАНИКА_ТЕЛА_НА_МОДУЛЬ
	)

	var энергетика := ЭнергетикаКлетки.new()
	энергетика.настроить(конструкция)
	энергетика.обновить(1.0, СОЛНЕЧНЫЙ_ПОТОК)

	var состояние: СостояниеКлетки = энергетика.состояние

	print("Энергия: %.12f" % состояние.энергия)
	print("Свободная органика: %.12f" % состояние.свободная_органика)
	print("Термат: %.12f" % состояние.термат)
	print("Поглощённое тепло термата: %.12f" % состояние.поглощенное_тепло_термата)
	print("Температура: %.12f" % состояние.температура)

	проверить_близко(состояние.энергия, 0.056112055550, "Энергия после одного такта")
	проверить_близко(состояние.свободная_органика, 0.0, "Свободная органика после одного такта")
	проверить_близко(состояние.термат, 0.010482965577, "Термат после одного такта")
	проверить_близко(состояние.поглощенное_тепло_термата, 0.000000017855, "Тепло термата после одного такта")
	проверить_близко(состояние.температура, 0.000170307270, "Температура после одного такта")


func вывести_геометрию(модули: Array[Dictionary]) -> void:
	print("\n--- Геометрия клетки ---")

	var форма := ФормаКлетки.new()
	var меш: ArrayMesh = форма.построить(модули, ОРГАНИКА_ТЕЛА_НА_МОДУЛЬ)

	if меш == null:
		зарегистрировать_ошибку("Форма эталонной клетки не построена.")
		return

	var количество_поверхностей: int = меш.get_surface_count()
	print("Поверхностей меша: %d" % количество_поверхностей)
	проверить_целое(количество_поверхностей, 1, "Количество поверхностей меша")

	if количество_поверхностей <= 0:
		return

	var массивы: Array = меш.surface_get_arrays(0)
	var вершины: PackedVector3Array = массивы[Mesh.ARRAY_VERTEX]
	var индексы: PackedInt32Array = массивы[Mesh.ARRAY_INDEX]
	var границы: AABB = меш.get_aabb()
	var точки_сцепки: Array[Vector3] = форма.получить_точки_сцепки()

	print("Вершин: %d" % вершины.size())
	print("Индексов: %d" % индексы.size())
	print("Треугольников: %d" % int(индексы.size() / 3))
	print("AABB позиция: %s" % вектор_в_строку(границы.position))
	print("AABB размер: %s" % вектор_в_строку(границы.size))
	print("Точек сцепки: %d" % точки_сцепки.size())

	for номер: int in range(точки_сцепки.size()):
		print("Точка сцепки %d: %s" % [номер, вектор_в_строку(точки_сцепки[номер])])

	проверить(вершины.size() > 0, "Меш содержит вершины")
	проверить(индексы.size() > 0, "Меш содержит индексы")
	проверить_целое(точки_сцепки.size(), 3, "Количество точек сцепки")


func проверить_повторения_функций(модули: Array[Dictionary]) -> void:
	print("\n--- Повторения функций 01–06 ---")

	var модули_с_повторами: Array[Dictionary] = скопировать_модули(модули)

	добавить_копию_типа(модули_с_повторами, модули, КодыГенов.ПОГЛОТИТЕЛЬ_ЭНЕРГИИ)
	добавить_копию_типа(модули_с_повторами, модули, КодыГенов.НАКОПИТЕЛЬ_ЭНЕРГИИ)
	добавить_копию_типа(модули_с_повторами, модули, КодыГенов.БИОСИНТЕЗАТОР)
	добавить_копию_типа(модули_с_повторами, модули, КодыГенов.НАКОПИТЕЛЬ_ОРГАНИКИ)
	добавить_копию_типа(модули_с_повторами, модули, КодыГенов.ТЕРМОСИНТЕЗАТОР)
	добавить_копию_типа(модули_с_повторами, модули, КодыГенов.НАКОПИТЕЛЬ_ТЕРМАТА)

	var результат_компиляции: Dictionary = КаноническийКомпиляторГенома.скомпилировать(
		модули_с_повторами
	)

	if результат_компиляции.has("ошибка"):
		зарегистрировать_ошибку("Компиляция повторений: %s" % результат_компиляции["ошибка"])
		return

	var геном: PackedByteArray = результат_компиляции["геном"]
	var результат_экспрессии: Dictionary = выразить_весь_геном(геном)

	if результат_экспрессии.has("ошибка"):
		зарегистрировать_ошибку("Экспрессия повторений: %s" % результат_экспрессии["ошибка"])
		return

	var выраженные_функции: Array[Dictionary] = результат_экспрессии["выраженные_функции"]
	var конструкция: КонструкцияКлетки = КомпоновщикКлетки.собрать(
		выраженные_функции,
		ОРГАНИКА_ТЕЛА_НА_МОДУЛЬ
	)

	var профиль: ПрофильФункций = конструкция.профиль
	var энергетика := ЭнергетикаКлетки.new()
	энергетика.настроить(конструкция)

	print("Функций: %d" % выраженные_функции.size())
	print("Структурная органика: %.9f" % конструкция.структурная_органика)
	print("Площадь поглощения: %.9f" % профиль.площадь_поглощения_энергии)
	print("Ёмкость энергии: %.9f" % профиль.емкость_энергии)
	print("Утечка при полном заполнении: %.9f" % профиль.утечка_энергии_при_полном_заполнении)
	print("Скорость биосинтеза: %.9f" % профиль.скорость_биосинтеза)
	print("Полезная мощность биосинтеза: %.9f" % профиль.полезная_мощность_биосинтеза)
	print("Ёмкость органики: %.9f" % профиль.емкость_органики)
	print("Скорость термосинтеза: %.9f" % профиль.скорость_термосинтеза)
	print("Энергозатраты термосинтеза: %.9f" % профиль.мощность_энергозатрат_термосинтеза)
	print("Создание термата: %.9f" % профиль.скорость_создания_термата)
