func скопировать_модули(модули: Array[Dictionary]) -> Array[Dictionary]:
	var копии: Array[Dictionary] = []

	for модуль: Dictionary in модули:
		копии.append(модуль.duplicate(true))

	return копии


func добавить_копию_типа(приемник: Array[Dictionary], источник: Array[Dictionary], тип: int) -> void:
	for модуль: Dictionary in источник:
		if int(модуль["тип"]) == тип:
			приемник.append(модуль.duplicate(true))
			return

	зарегистрировать_ошибку("Не найден модуль типа %02X для повторения." % тип)


func посчитать_тип(модули: Array[Dictionary], тип: int) -> int:
	var количество: int = 0

	for модуль: Dictionary in модули:
		if int(модуль["тип"]) == тип:
			количество += 1

	return количество


func проверить(условие: bool, название: String) -> void:
	if условие:
		print("[OK] %s" % название)
	else:
		зарегистрировать_ошибку(название)


func проверить_целое(фактическое: int, ожидаемое: int, название: String) -> void:
	if фактическое == ожидаемое:
		print("[OK] %s: %d" % [название, фактическое])
	else:
		зарегистрировать_ошибку("%s: ожидалось %d, получено %d" % [название, ожидаемое, фактическое])


func проверить_близко(фактическое: float, ожидаемое: float, название: String) -> void:
	if abs(фактическое - ожидаемое) <= ПОГРЕШНОСТЬ:
		print("[OK] %s: %.9f" % [название, фактическое])
	else:
		зарегистрировать_ошибку("%s: ожидалось %.9f, получено %.9f" % [название, ожидаемое, фактическое])


func зарегистрировать_ошибку(сообщение: String) -> void:
	количество_ошибок += 1
	print("[ОШИБКА] %s" % сообщение)


func вектор_в_строку(значение: Vector3) -> String:
	return "(%.9f, %.9f, %.9f)" % [значение.x, значение.y, значение.z]


func завершить_отчет() -> void:
	print("\n--- Итог R0 ---")

	if количество_ошибок == 0:
		print("R0: ВСЕ АВТОМАТИЧЕСКИЕ ПРОВЕРКИ ПРОЙДЕНЫ")
	else:
		print("R0: ОБНАРУЖЕНО ОШИБОК: %d" % количество_ошибок)

	print("========== КОНЕЦ R0 ==========\n")
