extends RefCounted

const КодыМодулей = preload("res://геном/коды_модулей.gd")


static func прочитать(части: PackedStringArray) -> Dictionary:
	if части.size() != 2:
		return {
			"ошибка": "Ген накопителя органики должен иметь формат 04,органика."
		}

	var текст_органики: String = части[1].strip_edges()

	if not текст_органики.is_valid_float():
		return {
			"ошибка": "Органика накопителя органики должна быть числом."
		}

	var органика: float = текст_органики.to_float()

	if органика <= 0.0:
		return {
			"ошибка": "Органика накопителя органики должна быть больше нуля."
		}

	return {
		"тип": КодыМодулей.НАКОПЛЕНИЕ_ОРГАНИКИ,
		"органика": органика
	}
